<style>
  :root {
    --ht-ink: #111114;
    --ht-paper: #f7f7f4;
    --ht-panel: #ffffff;
    --ht-line: #d8d8d2;
    --ht-reg: #e5007d;
    --ht-dim: #6b6b66;
    --ht-mono: SFMono-Regular, ui-monospace, Menlo, Consolas, monospace;
  }

  .ht-shell {
    background: var(--ht-paper);
    color: var(--ht-ink);
    display: flex;
    height: calc(100vh - 86px);
    min-height: 680px;
    overflow: hidden;
  }

  .ht-shell *,
  .ht-title * {
    box-sizing: border-box;
  }

  .ht-sidebar {
    background: var(--ht-paper);
    border-right: 1px solid var(--ht-line);
    flex: 0 0 320px;
    overflow-y: auto;
    padding: 12px 14px 28px;
  }

  .ht-stage {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .ht-topbar {
    align-items: center;
    background: var(--ht-panel);
    border-bottom: 1px solid var(--ht-line);
    display: flex;
    gap: 10px;
    padding: 10px 16px;
  }

  .ht-title {
    align-items: center;
    background: var(--ht-panel);
    border-bottom: 1px solid var(--ht-line);
    display: flex;
    gap: 12px;
    padding: 10px 18px;
  }

  .ht-title h4 {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .04em;
    margin: 0;
    text-transform: uppercase;
  }

  .ht-title small,
  .ht-meta {
    color: var(--ht-dim);
    font-family: var(--ht-mono);
    font-size: 11px;
  }

  .ht-title .btn {
    margin-left: auto;
    white-space: nowrap;
  }

  .ht-title > div {
    min-width: 0;
  }

  .ht-regmark {
    flex: 0 0 auto;
    height: 26px;
    width: 26px;
  }

  .ht-preset-row {
    display: grid;
    gap: 8px;
    grid-template-columns: minmax(0, 1fr) auto auto;
  }

  .ht-group {
    background: var(--ht-panel);
    border: 1px solid var(--ht-line);
    border-radius: 6px;
    margin-bottom: 10px;
    padding: 12px 14px;
  }

  .ht-group h5 {
    border-bottom: 1px solid var(--ht-line);
    color: var(--ht-dim);
    font-family: var(--ht-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: 8px;
    margin: -12px -14px 12px;
    padding: 11px 14px;
    text-transform: uppercase;
    user-select: none;
  }

  .ht-group h5::after {
    border-bottom: 1.5px solid currentColor;
    border-right: 1.5px solid currentColor;
    content: "";
    height: 7px;
    margin-left: auto;
    transform: rotate(45deg);
    transition: transform .15s ease;
    width: 7px;
  }

  .ht-group h5:focus-visible {
    outline: 2px solid var(--ht-reg);
    outline-offset: -2px;
  }

  .ht-group.is-collapsed {
    padding-bottom: 12px;
  }

  .ht-group.is-collapsed h5 {
    border-bottom: 0;
    margin-bottom: -12px;
  }

  .ht-group.is-collapsed h5::after {
    transform: rotate(-45deg);
  }

  .ht-group.is-collapsed > :not(h5) {
    display: none !important;
  }

  .ht-badge {
    background: var(--ht-reg);
    border-radius: 3px;
    color: #fff;
    display: none;
    font-size: 9px;
    letter-spacing: .05em;
    margin-left: auto;
    padding: 2px 6px;
  }

  .ht-badge.is-visible {
    display: inline-block;
  }

  .ht-group h5:has(.ht-badge.is-visible)::after {
    margin-left: 0;
  }

  .ht-row {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
  }

  .ht-row label,
  .ht-check {
    font-size: 12.5px;
  }

  .ht-val {
    background: var(--ht-paper);
    border: 1px solid var(--ht-line);
    border-radius: 3px;
    color: var(--ht-ink);
    font-family: var(--ht-mono);
    font-size: 11px;
    min-width: 54px;
    padding: 1px 6px;
    text-align: right;
  }

  .ht-number-wrap {
    align-items: center;
    background: var(--ht-paper);
    border: 1px solid var(--ht-line);
    border-radius: 3px;
    display: inline-flex;
    min-width: 70px;
    overflow: hidden;
  }

  .ht-number-input {
    appearance: textfield;
    background: transparent;
    border: 0;
    color: var(--ht-ink);
    font-family: var(--ht-mono);
    font-size: 11px;
    min-width: 0;
    padding: 2px 3px 2px 6px;
    text-align: right;
    width: 54px;
  }

  .ht-number-input::-webkit-inner-spin-button,
  .ht-number-input::-webkit-outer-spin-button {
    margin: 0;
  }

  .ht-number-input:focus {
    outline: none;
  }

  .ht-number-wrap:focus-within {
    border-color: var(--ht-reg);
    box-shadow: 0 0 0 1px var(--ht-reg);
  }

  .ht-unit {
    color: var(--ht-dim);
    font-family: var(--ht-mono);
    font-size: 10px;
    padding-right: 6px;
    white-space: nowrap;
  }

  .ht-input,
  .ht-select,
  .ht-button {
    background: var(--ht-panel);
    border: 1px solid var(--ht-line);
    border-radius: 4px;
    color: var(--ht-ink);
    font-family: var(--ht-mono);
    font-size: 12px;
    padding: 6px 8px;
    width: 100%;
  }

  .ht-button {
    cursor: pointer;
  }

  .ht-button:focus-visible,
  .ht-select:focus-visible,
  .ht-input:focus-visible,
  .ht-seg button:focus-visible {
    outline: 2px solid var(--ht-reg);
    outline-offset: 1px;
  }

  .ht-button:disabled,
  .ht-seg button:disabled,
  .ht-input:disabled,
  .ht-range:disabled {
    cursor: not-allowed;
    opacity: .45;
  }

  .ht-button-primary {
    background: var(--ht-ink);
    border-color: var(--ht-ink);
    color: var(--ht-paper);
    font-weight: 700;
    letter-spacing: .05em;
    padding: 10px;
    text-transform: uppercase;
  }

  .ht-button-primary:disabled {
    background: var(--ht-line);
    border-color: var(--ht-line);
    color: var(--ht-dim);
    cursor: not-allowed;
  }

  .ht-range {
    appearance: none;
    background: linear-gradient(to right, var(--ht-ink) var(--fill, 50%), var(--ht-line) var(--fill, 50%));
    border-radius: 2px;
    height: 3px;
    margin: 2px 0 12px;
    outline: none;
    width: 100%;
  }

  .ht-range::-webkit-slider-thumb {
    appearance: none;
    background: var(--ht-panel);
    border: 2px solid var(--ht-ink);
    border-radius: 50%;
    cursor: pointer;
    height: 14px;
    width: 14px;
  }

  .ht-seg {
    border: 1px solid var(--ht-line);
    border-radius: 4px;
    display: flex;
    overflow: hidden;
  }

  .ht-seg button {
    background: var(--ht-panel);
    border: 0;
    color: var(--ht-dim);
    cursor: pointer;
    flex: 1;
    font-family: var(--ht-mono);
    font-size: 12px;
    padding: 6px 7px;
  }

  .ht-seg button + button {
    border-left: 1px solid var(--ht-line);
  }

  .ht-seg button.on {
    background: var(--ht-ink);
    color: var(--ht-paper);
  }

  .ht-check {
    align-items: center;
    cursor: pointer;
    display: flex;
    gap: 8px;
    margin: 8px 0;
  }

  .ht-check input {
    accent-color: var(--ht-ink);
    height: 15px;
    width: 15px;
  }

  .ht-hint {
    color: var(--ht-dim);
    font-size: 11px;
    line-height: 1.45;
    margin: -4px 0 10px;
  }

  .ht-option-block {
    transition: opacity .15s ease;
  }

  .ht-option-block.is-disabled {
    opacity: .48;
  }

  .ht-option-block.is-disabled .ht-hint {
    margin-bottom: 0;
  }

  .ht-info {
    background: var(--ht-paper);
    border: 1px dashed var(--ht-line);
    border-radius: 4px;
    color: var(--ht-dim);
    font-family: var(--ht-mono);
    font-size: 11px;
    line-height: 1.55;
    padding: 8px 10px;
  }

  .ht-info b {
    color: var(--ht-ink);
  }

  #hist {
    background: var(--ht-paper);
    border: 1px solid var(--ht-line);
    border-radius: 4px;
    display: block;
    height: 64px;
    margin-bottom: 8px;
    width: 100%;
  }

  .ht-viewport {
    align-items: center;
    background:
      linear-gradient(45deg, #e9e9e4 25%, transparent 25%, transparent 75%, #e9e9e4 75%),
      linear-gradient(45deg, #e9e9e4 25%, transparent 25%, transparent 75%, #e9e9e4 75%);
    background-color: #f1f1ec;
    background-position: 0 0, 10px 10px;
    background-size: 20px 20px;
    display: flex;
    flex: 1;
    justify-content: center;
    min-height: 0;
    overflow: auto;
    position: relative;
  }

  .ht-viewport canvas {
    background: #fff;
    box-shadow: 0 2px 14px rgba(0, 0, 0, .16);
    cursor: crosshair;
    image-rendering: auto;
    max-height: calc(100% - 40px);
    max-width: calc(100% - 40px);
  }

  .ht-viewport.fit-off {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 20px;
  }

  .ht-viewport.fit-off canvas {
    image-rendering: pixelated;
    max-height: none;
    max-width: none;
  }

  .ht-busy {
    align-items: center;
    background: rgba(247, 247, 244, .72);
    display: none;
    font-family: var(--ht-mono);
    font-size: 12px;
    inset: 0;
    justify-content: center;
    position: absolute;
    z-index: 20;
  }

  .ht-busy.on {
    display: flex;
  }

  .ht-loupe {
    background: #fff;
    border: 2px solid var(--ht-ink);
    border-radius: 50%;
    box-shadow: 0 4px 18px rgba(0, 0, 0, .3);
    display: none;
    height: 180px;
    overflow: hidden;
    pointer-events: none;
    position: fixed;
    width: 180px;
    z-index: 1040;
  }

  .ht-loupe canvas {
    display: block;
    height: 100%;
    image-rendering: pixelated;
    width: 100%;
  }

  .ht-loupe::after {
    background:
      linear-gradient(var(--ht-reg), var(--ht-reg)) center / 1px 14px no-repeat,
      linear-gradient(var(--ht-reg), var(--ht-reg)) center / 14px 1px no-repeat;
    border-radius: 50%;
    content: "";
    inset: 0;
    opacity: .9;
    position: absolute;
  }

  .ht-footer {
    background: var(--ht-panel);
    border-top: 1px solid var(--ht-line);
    color: var(--ht-dim);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--ht-mono);
    font-size: 10.5px;
    gap: 18px;
    padding: 6px 18px;
  }

  @media (max-width: 900px) {
    .ht-shell {
      flex-direction: column;
      height: auto;
      min-height: 0;
    }

    .ht-sidebar {
      border-bottom: 1px solid var(--ht-line);
      border-right: 0;
      flex: none;
      max-height: none;
      width: 100%;
      max-width: 100%;
    }

    .ht-viewport {
      min-height: 520px;
    }

    .ht-topbar {
      align-items: stretch;
      flex-wrap: wrap;
    }

    .ht-topbar .ht-seg {
      flex: 1 1 280px;
      width: auto !important;
    }

    .ht-topbar .ht-meta {
      flex-basis: 100%;
      margin-left: 0 !important;
    }
  }

  @media (max-width: 520px) {
    .ht-title {
      align-items: flex-start;
      flex-wrap: wrap;
      padding: 10px 12px;
    }

    .ht-title .btn {
      margin-left: 38px;
    }

    .ht-sidebar {
      padding-left: 10px;
      padding-right: 10px;
    }

    .ht-preset-row {
      grid-template-columns: 1fr 1fr;
    }

    .ht-preset-row .ht-select {
      grid-column: 1 / -1;
    }

    .ht-preset-row .ht-button {
      width: 100% !important;
    }

    .ht-topbar .ht-seg {
      flex-basis: 100%;
    }

    .ht-seg button {
      font-size: 11px;
      padding-left: 4px;
      padding-right: 4px;
    }

    .ht-number-wrap {
      min-width: 64px;
    }

    .ht-number-input {
      width: 48px;
    }
  }
</style>

<div class="ht-title">
  <svg class="ht-regmark" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="12" fill="none" stroke="#e5007d" stroke-width="2"></circle>
    <line x1="20" y1="0" x2="20" y2="40" stroke="#111114" stroke-width="2"></line>
    <line x1="0" y1="20" x2="40" y2="20" stroke="#111114" stroke-width="2"></line>
  </svg>
  <div>
    <h4>Retino AM - Halftone DTF</h4>
    <small>Ordine <%= @order.external_order_code %> - <%= @item.sku %></small>
  </div>
  <a href="/orders/<%= @order.id %>/items/<%= @item.id %>" class="btn btn-outline-secondary btn-sm">
    <i class="fas fa-arrow-left"></i> Torna alla riga
  </a>
</div>

<div class="ht-shell">
  <aside class="ht-sidebar">
    <div class="ht-group">
      <h5>Preset</h5>
      <div class="ht-preset-row">
        <select id="dtfPreset" class="ht-select"></select>
        <button id="savePresetButton" type="button" class="ht-button" title="Salva preset" style="width:auto;white-space:nowrap"><i class="fas fa-save"></i> Salva</button>
        <button id="deletePresetButton" type="button" class="ht-button" title="Cancella preset" style="width:auto;white-space:nowrap" disabled><i class="fas fa-trash"></i> Elimina</button>
      </div>
    </div>

    <div class="ht-group is-collapsed">
      <h5>Immagine</h5>
      <div class="ht-info" id="imgInfo">caricamento sorgente...</div>
    </div>

    <div class="ht-group">
      <h5>Retino</h5>
      <div class="ht-row"><label for="dpi">Risoluzione stampa</label><span class="ht-val" id="dpiV">300</span></div>
      <input class="ht-range" type="range" id="dpi" min="150" max="1200" step="50" value="300">

      <div class="ht-row"><label for="printw">Larghezza stampa cm</label></div>
      <input class="ht-input" type="number" id="printw" min="1" max="300" step="0.01" value="<%= @png_info ? format('%.2f', @png_info[:print_width_cm]) : '' %>">
      <div class="ht-hint">Vuota = usa i pixel originali. Con valore in cm il canvas ricampiona prima del retino alla risoluzione scelta.</div>

      <div class="ht-row"><label for="lpi">Lineatura</label><span class="ht-val" id="lpiV">30</span></div>
      <input class="ht-range" type="range" id="lpi" min="15" max="85" step="1" value="30">

      <div class="ht-row"><label for="angle">Angolo</label><span class="ht-val" id="angleV">22.5 deg</span></div>
      <input class="ht-range" type="range" id="angle" min="0" max="90" step="0.5" value="22.5">

      <div class="ht-row"><label>Forma punto</label></div>
      <div class="ht-seg" id="spotSeg">
        <button type="button" data-v="round" class="on">Rotondo</button>
        <button type="button" data-v="euclid">Euclideo</button>
        <button type="button" data-v="ellipse">Ellittico</button>
        <button type="button" data-v="line">Linea</button>
      </div>
      <div class="ht-info mt-2" id="cellInfo"></div>
    </div>

    <div class="ht-group">
      <h5>Tono e copertura</h5>
      <label class="ht-check"><input type="checkbox" id="invert">Inverti copertura</label>
      <div class="ht-hint">Disattivato lavora sulle zone chiare; attivato sulle zone scure.</div>
      <canvas id="hist" width="256" height="64"></canvas>

      <div class="ht-row"><label for="lvB">Nero input</label><span class="ht-val" id="lvBV">0</span></div>
      <input class="ht-range" type="range" id="lvB" min="0" max="250" step="1" value="5">

      <div class="ht-row"><label for="lvG">Gamma</label><span class="ht-val" id="lvGV">1.00</span></div>
      <input class="ht-range" type="range" id="lvG" min="0.10" max="10.00" step="0.01" value="1.00">

      <div class="ht-row"><label for="lvW">Bianco input</label><span class="ht-val" id="lvWV">255</span></div>
      <input class="ht-range" type="range" id="lvW" min="5" max="255" step="1" value="100">

      <div class="ht-row"><label for="sat">Saturazione colore</label><span class="ht-val" id="satV">100%</span></div>
      <input class="ht-range" type="range" id="sat" min="0" max="250" step="5" value="100">
    </div>

    <div class="ht-group is-collapsed" data-active-control="dotChk">
      <h5>Punto minimo fisico <span class="ht-badge">Attivo</span></h5>
      <label class="ht-check"><input type="checkbox" id="dotChk">Imponi diametro minimo</label>
      <div class="ht-hint">Corregge i punti stampati troppo piccoli per trattenere la polvere. E diverso dal punto minimo tonale.</div>
      <div class="ht-option-block is-disabled" id="dotOptions">
        <div class="ht-row"><label for="dotPx">Diametro minimo</label><span class="ht-val" id="dotPxV">3 px</span></div>
        <input class="ht-range" type="range" id="dotPx" min="2" max="12" step="1" value="3" disabled>
        <div class="ht-row"><label>Punti sotto soglia</label></div>
        <div class="ht-seg" id="dotModeSeg">
          <button type="button" data-v="drop" class="on" disabled>Elimina</button>
          <button type="button" data-v="force" disabled>Porta al minimo</button>
        </div>
        <div class="ht-hint mt-2">Elimina produce alte luci piu pulite; Porta al minimo conserva piu dettaglio.</div>
        <div class="ht-info" id="dotInfo" style="display:none"></div>
      </div>
    </div>

    <div class="ht-group" data-active-control="knockChk">
      <h5>Tessuto come base <span class="ht-badge">Nuovo metodo</span></h5>
      <label class="ht-check"><input type="checkbox" id="knockChk">Usa colore tessuto come base</label>
      <div class="ht-row" style="gap:8px">
        <button id="pickBtn" type="button" class="ht-button" style="flex:1">Contagocce</button>
        <input type="color" id="fabricCol" value="#151515" style="width:42px;height:30px;border:1px solid var(--ht-line);border-radius:4px;padding:1px">
      </div>
      <div class="ht-hint" id="pickHint">Spento: metodo precedente. Acceso: separazione graduale dal colore tessuto.</div>

      <div class="ht-option-block is-disabled" id="fabricOptions">
        <div class="ht-row"><label for="fabricInner">Inizio transizione</label><span class="ht-val" id="fabricInnerV">3 ΔE</span></div>
        <input class="ht-range" type="range" id="fabricInner" min="0" max="20" step="0.5" value="3" disabled>

        <div class="ht-row"><label for="fabricOuter">Fine transizione</label><span class="ht-val" id="fabricOuterV">30 ΔE</span></div>
        <input class="ht-range" type="range" id="fabricOuter" min="20" max="80" step="1" value="30" disabled>

      </div>
      <div class="ht-row"><label for="cap">Copertura massima globale</label><span class="ht-val" id="capV">100%</span></div>
      <input class="ht-range" type="range" id="cap" min="40" max="100" step="1" value="100">
      <div class="ht-hint">100% conserva le campiture piene. Riduci il valore solo per alleggerire intenzionalmente ink e peso della stampa.</div>
    </div>

    <div class="ht-group">
      <h5>Export</h5>
      <div class="ht-row"><label>Resa</label></div>
      <div class="ht-seg" id="outSeg">
        <button type="button" data-v="color" class="on">Colore</button>
        <button type="button" data-v="kb">Nero/Bianco</button>
      </div>
      <label class="ht-check" style="justify-content:space-between">
        <span style="display:flex;align-items:center;gap:8px"><input type="checkbox" id="fabricChk">Simula tessuto sotto</span>
      </label>
      <div class="ht-hint">Solo anteprima. Il PNG esportato mantiene sempre la trasparenza.</div>
      <button class="ht-button ht-button-primary" id="btnSave" type="button" disabled>Esporta nel flusso</button>
      <div class="ht-hint mt-2" id="saveStatus">Il PNG finale viene salvato sull'asset, con backup automatico dell'originale.</div>
    </div>
  </aside>

  <section class="ht-stage">
    <div class="ht-topbar">
      <div class="ht-seg" id="viewSeg" style="width:360px">
        <button type="button" data-v="retino" class="on">Retino</button>
        <button type="button" data-v="original">Originale</button>
        <button type="button" data-v="mask">Maschera</button>
        <button type="button" data-v="shirt">Maglia</button>
      </div>
      <div class="ht-seg" id="zoomSeg" style="width:140px">
        <button type="button" data-v="fit" class="on">Adatta</button>
        <button type="button" data-v="100">100%</button>
      </div>
      <span class="ht-meta ms-auto" id="stageMeta">caricamento...</span>
    </div>
    <div class="ht-viewport" id="viewport">
      <canvas id="cv"></canvas>
      <div class="ht-busy" id="busy">retinatura...</div>
    </div>
    <div class="ht-footer">
      <span>pipeline: sRGB-&gt;lineare · LUT tono · soglia spot function · upload canvas</span>
      <span id="ftCell"></span>
      <span id="ftTime"></span>
    </div>
  </section>
</div>

<div class="ht-loupe" id="loupe"><canvas id="loupecv" width="90" height="90"></canvas></div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    'use strict';

    const SOURCE_URL = '/assets/<%= @asset.id %>/halftone/source';
    const EXPORT_URL = window.location.pathname.replace(/\/$/, '');
    const RETURN_URL = '/orders/<%= @order.id %>/items/<%= @item.id %>';
    const MAX_PIXELS = 80e6;
    const PHOTO_ALGORITHM = true;

    const S = {
      img: null,
      tone: null,
      guard: null,
      alpha: null,
      lab: null,
      hist: null,
      color: null,
      tw: 0,
      th: 0,
      spot: 'round',
      out: 'color',
      dotMode: 'drop',
      view: 'retino',
      fit: true,
      renderedMode: 'retino'
    };

    const $ = id => document.getElementById(id);
    const cv = $('cv');
    const ctx = cv.getContext('2d', { willReadFrequently: true });
    const viewport = $('viewport');
    const busy = $('busy');

    const s2l = new Float32Array(256);
    for (let i = 0; i < 256; i++) {
      const c = i / 255;
      s2l[i] = c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
    }

    function rgb2lab(r, g, b) {
      const R = s2l[r];
      const G = s2l[g];
      const B = s2l[b];
      let x = R * 0.4124 + G * 0.3576 + B * 0.1805;
      let y = R * 0.2126 + G * 0.7152 + B * 0.0722;
      let z = R * 0.0193 + G * 0.1192 + B * 0.9505;
      x /= 0.95047;
      z /= 1.08883;
      const f = t => t > 0.008856 ? Math.cbrt(t) : (7.787 * t + 16 / 116);
      const fx = f(x);
      const fy = f(y);
      const fz = f(z);
      return [116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)];
    }

    function P() {
      return {
        dpi: +$('dpi').value,
        printw: Math.max(0, parseFloat($('printw').value) || 0),
        lpi: +$('lpi').value,
        angle: +$('angle').value * Math.PI / 180,
        invert: $('invert').checked,
        fabricEnabled: $('knockChk').checked,
        black: +$('lvB').value,
        white: +$('lvW').value,
        lgamma: +$('lvG').value,
        sat: +$('sat').value / 100,
        fabricInner: +$('fabricInner').value,
        fabricOuter: Math.max(+$('fabricOuter').value, +$('fabricInner').value + 0.1),
        cap: +$('cap').value / 100
      };
    }

    function clampToRange(el, raw) {
      const min = Number(el.min);
      const max = Number(el.max);
      let value = Number(raw);
      if (!Number.isFinite(value)) value = Number(el.value) || min || 0;
      if (Number.isFinite(min)) value = Math.max(min, value);
      if (Number.isFinite(max)) value = Math.min(max, value);
      return value;
    }

    function isInRange(el, raw) {
      const value = Number(raw);
      const min = Number(el.min);
      const max = Number(el.max);
      if (!Number.isFinite(value)) return false;
      if (Number.isFinite(min) && value < min) return false;
      if (Number.isFinite(max) && value > max) return false;
      return true;
    }

    function setRangeDisabled(id, disabled) {
      const range = $(id);
      const number = $(id + 'N');
      if (range) range.disabled = disabled;
      if (number) number.disabled = disabled;
    }

    function bindRange(id, fmt, rebuildTone) {
      const el = $(id);
      const out = $(id + 'V');
      const number = document.createElement('input');
      const unit = document.createElement('span');
      number.className = 'ht-number-input';
      number.type = 'number';
      number.id = id + 'N';
      number.min = el.min;
      number.max = el.max;
      number.step = el.step;
      number.disabled = el.disabled;
      unit.className = 'ht-unit';
      out.className = 'ht-number-wrap';
      out.textContent = '';
      out.appendChild(number);
      out.appendChild(unit);
      const upd = () => {
        const formatted = fmt(+el.value);
        const parts = String(formatted).match(/^(-?\d+(?:\.\d+)?)(.*)$/);
        number.value = parts ? parts[1] : el.value;
        unit.textContent = parts ? parts[2].trim() : '';
        const p = (el.value - el.min) / (el.max - el.min) * 100;
        el.style.setProperty('--fill', p + '%');
      };
      el.addEventListener('input', () => {
        upd();
        schedule(Boolean(rebuildTone));
      });
      number.addEventListener('input', () => {
        if (number.value === '' || !isInRange(el, number.value)) return;
        el.value = number.value;
        upd();
        schedule(Boolean(rebuildTone));
      });
      number.addEventListener('change', () => {
        el.value = clampToRange(el, number.value);
        upd();
        schedule(Boolean(rebuildTone));
      });
      upd();
    }

    bindRange('dpi', v => v, true);
    bindRange('lpi', v => v, false);
    bindRange('angle', v => v + ' deg', false);
    bindRange('lvB', v => v, false);
    bindRange('lvG', v => v.toFixed(2), false);
    bindRange('lvW', v => v, false);
    bindRange('sat', v => v + '%', true);
    bindRange('dotPx', v => v + ' px', false);
    bindRange('fabricInner', v => v + ' ΔE', true);
    bindRange('fabricOuter', v => v + ' ΔE', true);
    bindRange('cap', v => v + '%', false);

    function syncFabricOptionState() {
      const enabled = $('knockChk').checked;
      ['fabricInner', 'fabricOuter'].forEach(id => setRangeDisabled(id, !enabled));
      $('fabricOptions').classList.toggle('is-disabled', !enabled);
      updateSectionBadges();
    }

    function syncDotOptionState() {
      const enabled = $('dotChk').checked;
      setRangeDisabled('dotPx', !enabled);
      $('dotModeSeg').querySelectorAll('button').forEach(button => { button.disabled = !enabled; });
      $('dotOptions').classList.toggle('is-disabled', !enabled);
      if (!enabled) $('dotInfo').style.display = 'none';
      updateSectionBadges();
    }

    function updateSectionBadges() {
      document.querySelectorAll('.ht-group[data-active-control]').forEach(group => {
        const control = $(group.dataset.activeControl);
        const badge = group.querySelector('.ht-badge');
        if (badge) badge.classList.toggle('is-visible', Boolean(control && control.checked));
      });
    }

    document.querySelectorAll('.ht-group > h5').forEach(heading => {
      const group = heading.parentElement;
      heading.setAttribute('role', 'button');
      heading.setAttribute('tabindex', '0');
      heading.setAttribute('aria-expanded', String(!group.classList.contains('is-collapsed')));
      const toggle = () => {
        group.classList.toggle('is-collapsed');
        heading.setAttribute('aria-expanded', String(!group.classList.contains('is-collapsed')));
      };
      heading.addEventListener('click', toggle);
      heading.addEventListener('keydown', event => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        toggle();
      });
    });

    $('invert').addEventListener('change', () => schedule(false));
    $('printw').addEventListener('input', () => schedule(true));
    $('fabricChk').addEventListener('change', () => schedule(false));
    $('knockChk').addEventListener('change', () => { syncFabricOptionState(); schedule(true); });
    $('fabricCol').addEventListener('input', () => { if ($('knockChk').checked) schedule(true); else schedule(false); });
    $('dotChk').addEventListener('change', () => {
      syncDotOptionState();
      schedule(false);
    });

    function bindSeg(id, cb) {
      $(id).addEventListener('click', e => {
        const b = e.target.closest('button');
        if (!b) return;
        $(id).querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
        cb(b.dataset.v);
      });
    }

    bindSeg('spotSeg', v => { S.spot = v; schedule(false); });
    bindSeg('outSeg', v => { S.out = v; schedule(false); });
    bindSeg('dotModeSeg', v => { S.dotMode = v; if ($('dotChk').checked) schedule(false); });
    bindSeg('viewSeg', v => { S.view = v; schedule(false); });
    bindSeg('zoomSeg', v => {
      S.fit = v === 'fit';
      applyView();
    });

    const presetSelect = $('dtfPreset');
    const savePresetButton = $('savePresetButton');
    const deletePresetButton = $('deletePresetButton');
    let customPresets = <%= (@halftone_presets || []).to_json %>;

    const presetFields = ['dpi', 'printw', 'lpi', 'angle', 'invert', 'lvB', 'lvG', 'lvW', 'sat', 'dotChk', 'dotPx', 'knockChk', 'fabricInner', 'fabricOuter', 'cap', 'fabricChk', 'fabricCol'];
    const builtinPresets = {
      gradient: {
        name: 'Retino AM / sfumature',
        dpi: '300', lpi: '30', angle: '22.5', spot: 'round', out: 'color',
        invert: '0', lvB: '5', lvG: '1.00', lvW: '100', sat: '100', dotChk: '0', dotPx: '3', dotMode: 'drop', knockChk: '0',
        fabricInner: '3', fabricOuter: '30', cap: '100', fabricChk: '0', fabricCol: '#151515'
      },
      black_shirt: {
        name: 'Maglia nera / colori vivi',
        dpi: '300', lpi: '30', angle: '22.5', spot: 'round', out: 'color',
        invert: '0', lvB: '0', lvG: '1.00', lvW: '255', sat: '135', dotChk: '0', dotPx: '3', dotMode: 'drop', knockChk: '0',
        fabricInner: '3', fabricOuter: '30', cap: '100', fabricChk: '1', fabricCol: '#151515'
      },
      soft: {
        name: 'Sfumatura morbida',
        dpi: '300', lpi: '35', angle: '22.5', spot: 'euclid', out: 'color',
        invert: '0', lvB: '0', lvG: '1.10', lvW: '255', sat: '120', dotChk: '0', dotPx: '3', dotMode: 'drop', knockChk: '0',
        fabricInner: '3', fabricOuter: '36', cap: '100', fabricChk: '0', fabricCol: '#151515'
      }
    };

    function setSegValue(id, value) {
      const seg = $(id);
      const button = seg.querySelector('button[data-v="' + value + '"]');
      if (!button) return;
      seg.querySelectorAll('button').forEach(x => x.classList.toggle('on', x === button));
      if (id === 'spotSeg') S.spot = value;
      if (id === 'outSeg') S.out = value;
      if (id === 'dotModeSeg') S.dotMode = value;
    }

    function normalizePreset(settings) {
      const normalized = Object.assign({}, settings || {});
      const pct = value => {
        const number = Number(value);
        if (Number.isNaN(number)) return value;
        return String(number <= 1 ? Math.round(number * 100) : number);
      };
      if (normalized.dot_shape && !normalized.spot) {
        normalized.spot = normalized.dot_shape === 'circle' ? 'round' : normalized.dot_shape;
      }
      if (normalized.mask_black !== undefined && normalized.lvB === undefined) normalized.lvB = normalized.mask_black;
      if (normalized.mask_white !== undefined && normalized.lvW === undefined) normalized.lvW = normalized.mask_white;
      if (normalized.mask_gamma !== undefined && normalized.lvG === undefined) normalized.lvG = normalized.mask_gamma;
      if (normalized.max_coverage !== undefined && normalized.cap === undefined) normalized.cap = pct(normalized.max_coverage);
      if (normalized.knockout_inner !== undefined && normalized.fabricInner === undefined) normalized.fabricInner = normalized.knockout_inner;
      if (normalized.knockout_outer !== undefined && normalized.fabricOuter === undefined) normalized.fabricOuter = normalized.knockout_outer;
      if (normalized.tol !== undefined && normalized.fabricOuter === undefined) normalized.fabricOuter = normalized.tol;
      if (normalized.saturation !== undefined && normalized.sat === undefined) {
        const saturation = Number(normalized.saturation);
        normalized.sat = Number.isNaN(saturation) ? normalized.saturation : String(Math.round(saturation * 100));
      }
      return normalized;
    }

    function applyPreset(settings) {
      settings = normalizePreset(settings);
      presetFields.forEach(id => {
        if (settings[id] === undefined) return;
        const field = $(id);
        if (!field) return;
        if (field.type === 'checkbox') field.checked = ['1', 'true', true, 'on'].includes(settings[id]);
        else field.value = settings[id];
        if (field.type === 'range') field.dispatchEvent(new Event('input'));
      });
      if (settings.spot) setSegValue('spotSeg', settings.spot);
      if (settings.out) setSegValue('outSeg', settings.out);
      if (settings.dotMode) setSegValue('dotModeSeg', settings.dotMode);
      syncDotOptionState();
      syncFabricOptionState();
      schedule(true);
    }

    function currentPresetSettings() {
      const settings = {};
      presetFields.forEach(id => {
        const field = $(id);
        if (!field) return;
        settings[id] = field.type === 'checkbox' ? (field.checked ? '1' : '0') : field.value;
      });
      settings.spot = S.spot;
      settings.out = S.out;
      settings.dotMode = S.dotMode;
      // The production export is rendered by the authoritative server engine.
      settings.tone_mode = $('knockChk').checked ? 'dtf_difference' : 'retino_am';
      settings.server_render = '1';
      return settings;
    }

    function renderPresetOptions(selectedValue) {
      presetSelect.innerHTML = '';
      Object.keys(builtinPresets).forEach(key => {
        const option = document.createElement('option');
        option.value = 'builtin:' + key;
        option.textContent = builtinPresets[key].name;
        presetSelect.appendChild(option);
      });

      if (customPresets.length > 0) {
        const group = document.createElement('optgroup');
        group.label = 'Preset salvati';
        customPresets.forEach(preset => {
          const option = document.createElement('option');
          option.value = 'custom:' + preset.id;
          option.textContent = preset.name;
          group.appendChild(option);
        });
        presetSelect.appendChild(group);
      }

      presetSelect.value = selectedValue || 'builtin:gradient';
      updateDeletePresetState();
    }

    function selectedCustomPreset() {
      if (!presetSelect.value.startsWith('custom:')) return null;
      const id = Number(presetSelect.value.replace('custom:', ''));
      return customPresets.find(preset => preset.id === id) || null;
    }

    function updateDeletePresetState() {
      deletePresetButton.disabled = selectedCustomPreset() === null;
    }

    presetSelect.addEventListener('change', event => {
      const value = event.target.value;
      if (value.startsWith('builtin:')) applyPreset(builtinPresets[value.replace('builtin:', '')]);
      else {
        const preset = selectedCustomPreset();
        if (preset) applyPreset(preset.settings);
      }
      updateDeletePresetState();
    });

    savePresetButton.addEventListener('click', async () => {
      const current = selectedCustomPreset();
      const name = window.prompt('Nome preset', current ? current.name : '');
      if (!name || name.trim() === '') return;

      try {
        const response = await fetch('/halftone_presets', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name.trim(), settings: currentPresetSettings() })
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'Salvataggio preset fallito');
        customPresets = customPresets.filter(preset => preset.id !== result.preset.id);
        customPresets.push(result.preset);
        customPresets.sort((a, b) => a.name.localeCompare(b.name));
        renderPresetOptions('custom:' + result.preset.id);
        $('saveStatus').textContent = 'Preset salvato: ' + result.preset.name;
      } catch (error) {
        window.alert(error.message);
      }
    });

    deletePresetButton.addEventListener('click', async () => {
      const preset = selectedCustomPreset();
      if (!preset) return;
      if (!window.confirm('Cancellare il preset "' + preset.name + '"?')) return;

      try {
        const response = await fetch('/halftone_presets/' + preset.id, { method: 'DELETE' });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error(result.error || 'Cancellazione preset fallita');
        customPresets = customPresets.filter(item => item.id !== preset.id);
        renderPresetOptions('builtin:gradient');
        applyPreset(builtinPresets.gradient);
        $('saveStatus').textContent = 'Preset eliminato.';
      } catch (error) {
        window.alert(error.message);
      }
    });

    function loadSource() {
      const img = new Image();
      img.onload = () => {
        S.img = img;
        $('btnSave').disabled = false;
        schedule(true);
      };
      img.onerror = () => {
        $('stageMeta').textContent = 'errore caricamento sorgente';
        $('imgInfo').textContent = 'Impossibile caricare il PNG sorgente.';
      };
      img.src = SOURCE_URL + '?t=' + Date.now();
    }

    function buildTone() {
      if (!S.img) return;
      const p = P();
      let w;
      let h;
      if (p.printw > 0) {
        w = Math.round(p.printw / 2.54 * p.dpi);
        h = Math.round(w * S.img.naturalHeight / S.img.naturalWidth);
      } else {
        w = S.img.naturalWidth;
        h = S.img.naturalHeight;
      }

      if (w * h > MAX_PIXELS) {
        throw new Error('immagine troppo grande per il browser: riduci cm o DPI');
      }

      const off = document.createElement('canvas');
      off.width = w;
      off.height = h;
      const octx = off.getContext('2d', { willReadFrequently: true });
      octx.imageSmoothingEnabled = true;
      octx.imageSmoothingQuality = 'high';
      octx.drawImage(S.img, 0, 0, w, h);
      const imgd = octx.getImageData(0, 0, w, h);
      const d = imgd.data;
      const maskSource = PHOTO_ALGORITHM ? new Uint8ClampedArray(d) : d;
      const lab = new Float32Array(w * h * 3);
      for (let i = 0, j = 0; i < w * h; i++, j += 4) {
        const L = rgb2lab(d[j], d[j + 1], d[j + 2]);
        lab[i * 3] = L[0];
        lab[i * 3 + 1] = L[1];
        lab[i * 3 + 2] = L[2];
      }
      S.lab = lab;

      const sat = p.sat;

      if (sat !== 1) {
        for (let j = 0; j < d.length; j += 4) {
          const lum = 0.299 * d[j] + 0.587 * d[j + 1] + 0.114 * d[j + 2];
          d[j] = Math.max(0, Math.min(255, lum + (d[j] - lum) * sat));
          d[j + 1] = Math.max(0, Math.min(255, lum + (d[j + 1] - lum) * sat));
          d[j + 2] = Math.max(0, Math.min(255, lum + (d[j + 2] - lum) * sat));
        }
      }

      S.color = new Uint32Array(d.buffer.slice(0));
      S.tone = new Float32Array(w * h);
      S.guard = new Float32Array(w * h);
      S.alpha = new Float32Array(w * h);
      S.hist = new Uint32Array(256);
      const fabricHex = $('fabricCol').value;
      const fabricR = parseInt(fabricHex.slice(1, 3), 16);
      const fabricG = parseInt(fabricHex.slice(3, 5), 16);
      const fabricB = parseInt(fabricHex.slice(5, 7), 16);
      const technicalBlack = Math.max(fabricR, fabricG, fabricB) <= 32;
      const separationR = technicalBlack ? 0 : fabricR;
      const separationG = technicalBlack ? 0 : fabricG;
      const separationB = technicalBlack ? 0 : fabricB;
      const fabricLab = rgb2lab(separationR, separationG, separationB);
      const fabricEnabled = $('knockChk').checked;

      for (let i = 0, j = 0; i < S.tone.length; i++, j += 4) {
        const a = d[j + 3] / 255;
        let enc;
        if (PHOTO_ALGORITHM && fabricEnabled) {
          enc = (0.230 * Math.abs(maskSource[j] - separationR) + 0.520 * Math.abs(maskSource[j + 1] - separationG) + 0.250 * Math.abs(maskSource[j + 2] - separationB)) / 255;
          const dL = lab[i * 3] - fabricLab[0];
          const da = lab[i * 3 + 1] - fabricLab[1];
          const db = lab[i * 3 + 2] - fabricLab[2];
          const deltaE = Math.sqrt(dL * dL + da * da + db * db);
          const gx = Math.max(0, Math.min(1, (deltaE - p.fabricInner) / Math.max(0.1, p.fabricOuter - p.fabricInner)));
          S.guard[i] = gx * gx * (3 - 2 * gx);
        } else {
          const L = 0.2126 * s2l[d[j]] + 0.7152 * s2l[d[j + 1]] + 0.0722 * s2l[d[j + 2]];
          enc = (L <= 0.0031308 ? L * 12.92 : 1.055 * Math.pow(L, 1 / 2.4) - 0.055) * a;
        }
        S.tone[i] = enc;
        S.alpha[i] = a;
        S.hist[Math.max(0, Math.min(255, (enc * 255) | 0))]++;
      }

      S.tw = w;
      S.th = h;
      const cmW = (w / p.dpi * 2.54).toFixed(2);
      const cmH = (h / p.dpi * 2.54).toFixed(2);
      $('imgInfo').innerHTML =
        'sorgente: <b>' + S.img.naturalWidth + ' x ' + S.img.naturalHeight + '</b> px<br>' +
        'lavoro: <b>' + w + ' x ' + h + '</b> px<br>' +
        'stampa: <b>' + cmW + ' x ' + cmH + ' cm</b> @ ' + p.dpi + ' dpi';
    }

    function makeSpot(kind) {
      if (kind === 'round') return (x, y) => {
        const raw = Math.max(0, Math.min(1, (x * x + y * y) * 0.5));
        const radiusSquared = 2 * raw;
        if (raw <= 0.5) return Math.PI * radiusSquared / 4;
        const radius = Math.sqrt(radiusSquared);
        const cornerSegment = radiusSquared * Math.acos(1 / radius) - Math.sqrt(radiusSquared - 1);
        return (Math.PI * radiusSquared - 4 * cornerSegment) / 4;
      };
      if (kind === 'ellipse') return (x, y) => Math.max(0, Math.min(1, (x * x / 1.55 + y * y * 1.55) * 0.5));
      if (kind === 'line') return (_x, y) => Math.abs(y);
      return (x, y) => {
        const a = Math.abs(x);
        const b = Math.abs(y);
        const s = (a + b <= 1) ? 1 - (x * x + y * y) : ((a - 1) * (a - 1) + (b - 1) * (b - 1)) - 1;
        return (1 - s) * 0.5;
      };
    }

    function leveledCoverage(value, p) {
      let v = value;
      const span = Math.max(1, p.white - p.black);
      v = (v * 255 - p.black) / span;
      if (v <= 0) return 0;
      if (v >= 1) return 1;
      return Math.pow(v, 1 / Math.max(0.01, p.lgamma));
    }

    function coverageAt(tone, alpha, p, guard = 1) {
      if (alpha <= 0.01) return 0;
      const coverage = leveledCoverage(p.invert ? 1 - tone : tone, p);
      if (PHOTO_ALGORITHM && p.fabricEnabled) {
        return Math.min(p.cap, coverage * guard) * alpha;
      }
      // Legacy retino_am already includes alpha in its tone calculation and
      // deliberately preserves full-coverage pixels.
      return coverage >= 1 ? 1 : Math.min(p.cap, coverage);
    }

    function drawHist() {
      const hc = $('hist');
      const hx = hc.getContext('2d');
      hx.clearRect(0, 0, 256, 64);
      if (!S.hist) return;
      const p = P();
      let max = 1;
      for (let i = 0; i < 256; i++) if (S.hist[i] > max) max = S.hist[i];
      const sq = Math.sqrt(max);
      hx.fillStyle = '#b9b9b2';
      for (let i = 0; i < 256; i++) {
        const hgt = Math.sqrt(S.hist[i]) / sq * 58;
        if (hgt > 0) hx.fillRect(i, 64 - hgt, 1, hgt);
      }
      const mid = p.black + (p.white - p.black) * Math.pow(0.5, p.lgamma);
      hx.fillStyle = '#111114';
      hx.fillRect(p.black, 0, 1.5, 64);
      hx.fillStyle = '#e5007d';
      hx.fillRect(mid, 0, 1.5, 64);
      hx.strokeStyle = '#111114';
      hx.strokeRect(p.white - 1, 0, 1.5, 64);
      hx.fillStyle = 'rgba(17,17,20,.08)';
      hx.fillRect(0, 0, p.black, 64);
      hx.fillRect(p.white, 0, 256 - p.white, 64);
    }

    function render() {
      if (!S.tone) return;
      const t0 = performance.now();
      const p = P();
      const w = S.tw;
      const h = S.th;
      const cell = p.dpi / p.lpi;
      const cos = Math.cos(p.angle);
      const sin = Math.sin(p.angle);
      const spot = makeSpot(S.spot);

      cv.width = w;
      cv.height = h;
      const imgd = ctx.createImageData(w, h);
      const out = new Uint32Array(imgd.data.buffer);
      const color = S.color;
      const useColor = S.out === 'color';
      const ink = 0xFF141411;
      let bg = S.out === 'kb' ? 0xFFFFFFFF : 0x00000000;

      const showFabric = $('fabricChk').checked || S.view === 'shirt';
      if (showFabric && bg === 0 && S.view !== 'mask') {
        const hex = $('fabricCol').value;
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        bg = (0xFF << 24 | b << 16 | g << 8 | r) >>> 0;
      }

      const enforcePhysicalDot = $('dotChk').checked && (S.view === 'retino' || S.view === 'shirt');
      const inkMask = enforcePhysicalDot ? new Uint8Array(w * h) : null;
      if (!enforcePhysicalDot) $('dotInfo').style.display = 'none';
      const invCell = 1 / cell;
      for (let y = 0; y < h; y++) {
        const ys = y * sin;
        const yc = y * cos;
        const row = y * w;
        for (let x = 0; x < w; x++) {
          const i = row + x;
          const c = coverageAt(S.tone[i], S.alpha[i], p, S.guard ? S.guard[i] : 1);
          if (S.view === 'mask') {
            const g = Math.max(0, Math.min(255, Math.round(c * 255)));
            out[i] = (0xFF << 24 | g << 16 | g << 8 | g) >>> 0;
            continue;
          }
          if (S.view === 'original') {
            out[i] = S.alpha[i] > 0 ? (color[i] | 0xFF000000) : bg;
            continue;
          }
          if (c <= 0) {
            out[i] = bg;
            continue;
          }
          if (c >= 1) {
            out[i] = useColor ? (color[i] | 0xFF000000) : ink;
            if (inkMask) inkMask[i] = 1;
            continue;
          }
          const xr = x * cos - ys;
          const yr = x * sin + yc;
          let u = (xr * invCell) % 1;
          let v = (yr * invCell) % 1;
          if (u < 0) u += 1;
          if (v < 0) v += 1;
          const sx = u * 2 - 1;
          const sy = v * 2 - 1;
          const threshold = spot(sx, sy);
          if (c > threshold) {
            out[i] = useColor ? (color[i] | 0xFF000000) : ink;
            if (inkMask) inkMask[i] = 1;
          } else {
            out[i] = bg;
          }
        }
      }

      if (inkMask) {
        enforceMinDot(out, inkMask, w, h, +$('dotPx').value, S.dotMode, useColor, color, ink, bg, S.alpha, null);
      }
      ctx.putImageData(imgd, 0, 0);
      S.renderedMode = S.view;
      applyView();
      drawHist();

      const ms = (performance.now() - t0).toFixed(0);
      const dotUm = (25400 / p.lpi).toFixed(0);
      $('cellInfo').innerHTML =
        'cella: <b>' + cell.toFixed(1) + ' px</b> · passo punto: <b>' + dotUm + ' um</b> (' + (dotUm / 1000).toFixed(2) + ' mm)' +
        (cell < 4 ? '<br><span style="color:var(--ht-reg)">cella &lt; 4 px: aumenta DPI o riduci LPI</span>' : '');
      $('ftCell').textContent = 'cella ' + cell.toFixed(1) + 'px @ ' + p.dpi + 'dpi';
      $('ftTime').textContent = ms + ' ms';
      $('stageMeta').textContent = w + ' x ' + h + ' px · lente 1:1 col mouse';
    }

    function enforceMinDot(out, inkMask, width, height, diameter, mode, useColor, color, ink, bg, alpha, knock) {
      const minArea = Math.max(2, Math.round(Math.PI * diameter * diameter / 4));
      const visited = new Uint8Array(width * height);
      const stack = [];
      const componentPixels = new Int32Array(minArea);
      const radius = diameter / 2;
      const radiusInt = Math.ceil(radius);
      let removed = 0;
      let grown = 0;

      for (let start = 0; start < width * height; start++) {
        if (!inkMask[start] || visited[start]) continue;

        visited[start] = 1;
        stack.length = 0;
        stack.push(start);
        let area = 0;
        let sumX = 0;
        let sumY = 0;

        while (stack.length) {
          const index = stack.pop();
          if (area < minArea) componentPixels[area] = index;
          area++;
          const x = index % width;
          sumX += x;
          sumY += (index / width) | 0;

          if (x > 0 && inkMask[index - 1] && !visited[index - 1]) {
            visited[index - 1] = 1;
            stack.push(index - 1);
          }
          if (x < width - 1 && inkMask[index + 1] && !visited[index + 1]) {
            visited[index + 1] = 1;
            stack.push(index + 1);
          }
          if (index >= width && inkMask[index - width] && !visited[index - width]) {
            visited[index - width] = 1;
            stack.push(index - width);
          }
          if (index < width * (height - 1) && inkMask[index + width] && !visited[index + width]) {
            visited[index + width] = 1;
            stack.push(index + width);
          }
        }

        if (area >= minArea) continue;
        for (let i = 0; i < area; i++) out[componentPixels[i]] = bg;

        if (mode === 'force') {
          const centerX = Math.round(sumX / area);
          const centerY = Math.round(sumY / area);
          for (let dy = -radiusInt; dy <= radiusInt; dy++) {
            const y = centerY + dy;
            if (y < 0 || y >= height) continue;
            for (let dx = -radiusInt; dx <= radiusInt; dx++) {
              const x = centerX + dx;
              if (x < 0 || x >= width || dx * dx + dy * dy > radius * radius) continue;
              const index = y * width + x;
              if (alpha[index] <= 0.01 || (knock && knock[index])) continue;
              out[index] = useColor ? (color[index] | 0xFF000000) : ink;
            }
          }
          grown++;
        } else {
          removed++;
        }
      }

      const info = $('dotInfo');
      info.style.display = 'block';
      info.innerHTML = mode === 'force'
        ? 'Punti portati al diametro minimo: <b>' + grown + '</b>'
        : 'Punti eliminati sotto soglia: <b>' + removed + '</b>';
    }

    function applyView() {
      viewport.classList.toggle('fit-off', !S.fit);
      if (!S.fit) {
        cv.style.width = cv.width + 'px';
        cv.style.height = cv.height + 'px';
      } else {
        cv.style.width = '';
        cv.style.height = '';
      }
    }

    let picking = false;
    $('pickBtn').addEventListener('click', () => {
      picking = !picking;
      $('pickBtn').style.background = picking ? 'var(--ht-ink)' : '';
      $('pickBtn').style.color = picking ? 'var(--ht-paper)' : '';
      $('pickHint').innerHTML = picking ? '<b style="color:var(--ht-reg)">Clicca un punto della preview</b>' : 'Preleva il colore dalla preview oppure sceglilo dal riquadro.';
      cv.style.cursor = picking ? 'copy' : 'crosshair';
    });

    cv.addEventListener('click', e => {
      if (!picking || !S.color) return;
      const r = cv.getBoundingClientRect();
      const px = Math.floor((e.clientX - r.left) / r.width * cv.width);
      const py = Math.floor((e.clientY - r.top) / r.height * cv.height);
      const i = py * S.tw + px;
      if (i < 0 || i >= S.tw * S.th) return;
      const c = S.color[i];
      const rr = c & 0xFF;
      const gg = (c >> 8) & 0xFF;
      const bb = (c >> 16) & 0xFF;
      const hex = '#' + [rr, gg, bb].map(v => v.toString(16).padStart(2, '0')).join('');
      $('fabricCol').value = hex;
      $('knockChk').checked = true;
      syncFabricOptionState();
      picking = false;
      $('pickBtn').style.background = '';
      $('pickBtn').style.color = '';
      cv.style.cursor = 'crosshair';
      $('pickHint').innerHTML = 'Colore tessuto prelevato: <b>' + hex + '</b>.';
      schedule(true);
    });

    const loupe = $('loupe');
    const loupecv = $('loupecv');
    const lctx = loupecv.getContext('2d');
    lctx.imageSmoothingEnabled = false;
    cv.addEventListener('mousemove', e => {
      if (!S.tone || picking) {
        loupe.style.display = 'none';
        return;
      }
      const r = cv.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width * cv.width;
      const py = (e.clientY - r.top) / r.height * cv.height;
      lctx.clearRect(0, 0, 90, 90);
      lctx.drawImage(cv, px - 45, py - 45, 90, 90, 0, 0, 90, 90);
      loupe.style.display = 'block';
      loupe.style.left = (e.clientX + 22) + 'px';
      loupe.style.top = (e.clientY - 90) + 'px';
    });
    cv.addEventListener('mouseleave', () => { loupe.style.display = 'none'; });

    const crcT = (() => {
      const t = new Uint32Array(256);
      for (let n = 0; n < 256; n++) {
        let c = n;
        for (let k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
        t[n] = c;
      }
      return t;
    })();

    function crc32(buf) {
      let c = 0xFFFFFFFF;
      for (let i = 0; i < buf.length; i++) c = crcT[(c ^ buf[i]) & 0xFF] ^ (c >>> 8);
      return (c ^ 0xFFFFFFFF) >>> 0;
    }

    function pngWithDpi(dataUrl, dpi) {
      const bin = atob(dataUrl.split(',')[1]);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const ppm = Math.round(dpi / 0.0254);
      const ch = new Uint8Array(21);
      const dv = new DataView(ch.buffer);
      dv.setUint32(0, 9);
      ch[4] = 0x70; ch[5] = 0x48; ch[6] = 0x59; ch[7] = 0x73;
      dv.setUint32(8, ppm);
      dv.setUint32(12, ppm);
      ch[16] = 1;
      dv.setUint32(17, crc32(ch.subarray(4, 17)));
      const out = new Uint8Array(bytes.length + 21);
      out.set(bytes.subarray(0, 33), 0);
      out.set(ch, 33);
      out.set(bytes.subarray(33), 54);
      let s = '';
      const K = 0x8000;
      for (let i = 0; i < out.length; i += K) s += String.fromCharCode.apply(null, out.subarray(i, Math.min(i + K, out.length)));
      return 'data:image/png;base64,' + btoa(s);
    }

    function dataUrlToBlob(dataUrl) {
      const parts = dataUrl.split(',');
      const mime = parts[0].match(/:(.*?);/)[1];
      const bin = atob(parts[1]);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      return new Blob([bytes], { type: mime });
    }

    async function exportToServer() {
      if (!S.tone) return;
      const button = $('btnSave');
      button.disabled = true;
      const exportSettings = currentPresetSettings();
      const formData = new FormData();

      if (exportSettings.server_render !== '1') {
        $('saveStatus').textContent = 'Preparo PNG...';
        const oldView = S.view;
        const fabricWas = $('fabricChk').checked;
        S.view = 'retino';
        $('fabricChk').checked = false;
        render();

        let dataUrl = cv.toDataURL('image/png');
        try { dataUrl = pngWithDpi(dataUrl, P().dpi); } catch (error) { console.error('pHYs', error); }
        const blob = dataUrlToBlob(dataUrl);
        formData.append('png', blob, 'retino_canvas.png');

        S.view = oldView;
        $('fabricChk').checked = fabricWas;
        setSegValue('viewSeg', oldView);
        render();
      }
      formData.append('settings', JSON.stringify(exportSettings));
      $('saveStatus').textContent = 'Elaborazione sul server (circa 10 secondi)...';

      try {
        const response = await fetch(EXPORT_URL, {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: formData
        });
        const responseText = await response.text();
        let result = null;
        try {
          result = responseText ? JSON.parse(responseText) : {};
        } catch (parseError) {
          const plainText = responseText.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
          throw new Error(plainText ? plainText.slice(0, 180) : ('Risposta non JSON dal server (' + response.status + ')'));
        }
        if (!response.ok || !result.success) throw new Error(result.error || 'Export fallito');
        window.location.href = result.redirect_url || RETURN_URL;
      } catch (error) {
        $('saveStatus').textContent = 'Errore export: ' + error.message;
        button.disabled = false;
      }
    }

    $('btnSave').addEventListener('click', exportToServer);

    let raf = 0;
    let needTone = false;
    function schedule(rebuildTone) {
      if (rebuildTone) needTone = true;
      if (raf) return;
      busy.classList.add('on');
      raf = requestAnimationFrame(() => {
        raf = 0;
        setTimeout(() => {
          try {
            if (S.img && needTone) {
              buildTone();
              needTone = false;
            }
            render();
          } catch (error) {
            $('stageMeta').textContent = 'errore: ' + error.message;
            console.error(error);
          } finally {
            busy.classList.remove('on');
          }
        }, 10);
      });
    }

    renderPresetOptions('builtin:gradient');
    applyPreset(builtinPresets.gradient);
    loadSource();
  });
</script>
