<% if params[:text].present? %>
  <div class="alert alert-<%= params[:msg] == 'error' ? 'danger' : 'success' %> alert-dismissible fade show">
    <%= Rack::Utils.escape_html(params[:text]) %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% end %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="mb-1"><i class="fas fa-diagram-project me-2"></i>Automazioni</h1>
    <p class="text-muted mb-0">Flussi programmabili, lavorazioni Adobe, imposizione e consegna alle hot folder.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-outline-secondary" href="/automation_presets"><i class="fas fa-sliders me-2"></i>Preset</a>
    <a class="btn btn-outline-secondary" href="/automation_runs"><i class="fas fa-clock-rotate-left me-2"></i>Esecuzioni</a>
    <form method="post" action="/automations/seed_plectrum">
      <button class="btn btn-primary"><i class="fas fa-wand-magic-sparkles me-2"></i>Prepara flusso plettri</button>
    </form>
    <form method="post" action="/automations/seed_scatoline_aggregation">
      <button class="btn btn-outline-primary"><i class="fas fa-layer-group me-2"></i>Esempio aggregazione scatoline</button>
    </form>
    <form method="post" action="/automations/seed_layered_assets">
      <button class="btn btn-outline-primary"><i class="fas fa-object-group me-2"></i>Esempio stampa + livello</button>
    </form>
    <form method="post" action="/automations/seed_manual_plectrum">
      <button class="btn btn-outline-primary"><i class="fas fa-hand-pointer me-2"></i>Prepara plettri manuale</button>
    </form>
    <form method="post" action="/automations/import" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
      <label class="btn btn-outline-success mb-0">
        <i class="fas fa-file-import me-1"></i>Importa flusso
        <input type="file" name="flow_file" accept=".json,.automation.json,application/json" hidden required
               onchange="this.form.submit()">
      </label>
    </form>
  </div>
</div>

<div class="row g-4">
  <div class="col-xl-8">
    <div class="card shadow-sm mb-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <strong>Cartelle automazioni</strong>
          <div class="small text-muted">Organizzazione manuale dei flussi. I collegamenti di esecuzione restano indipendenti.</div>
        </div>
        <span class="badge bg-secondary"><%= @automation_folders.size %></span>
      </div>
      <div class="card-body">
        <% @automation_folders.each do |folder| %>
          <% rows = automation_chain_rows(folder) %>
          <details class="border rounded mb-3" open>
            <summary class="p-3 d-flex align-items-center justify-content-between gap-3">
              <span>
                <i class="fas fa-folder-open text-warning me-2"></i>
                <strong><%= Rack::Utils.escape_html(folder.name) %></strong>
                <% if folder.description.present? %>
                  <span class="text-muted ms-2"><%= Rack::Utils.escape_html(folder.description) %></span>
                <% end %>
              </span>
              <span class="badge bg-light text-dark"><%= rows.size %> <%= rows.size == 1 ? 'flusso' : 'flussi' %></span>
            </summary>
            <div class="border-top px-3 py-2 bg-light">
              <form method="post" action="/automation_folders/<%= folder.id %>/update" class="d-flex flex-wrap gap-2 align-items-center">
                <label class="small text-muted" for="folder-name-<%= folder.id %>">Nome cartella</label>
                <input class="form-control form-control-sm" style="max-width: 320px" id="folder-name-<%= folder.id %>"
                       name="name" value="<%= Rack::Utils.escape_html(folder.name) %>" required>
                <button class="btn btn-sm btn-outline-primary" type="submit">
                  <i class="fas fa-save me-1"></i>Salva nome
                </button>
              </form>
            </div>
            <div class="border-top">
              <% rows.each do |row| %>
                <% flow = row[:flow] %>
                <% targets = AutomationFlow.where(id: flow.handoff_target_ids).ordered %>
                <div class="d-flex align-items-center justify-content-between gap-3 px-3 py-2 border-bottom">
                  <div>
                    <i class="fas fa-diagram-project text-primary me-2"></i>
                    <a href="/automations/<%= flow.id %>/edit" class="fw-semibold text-decoration-none">
                      <%= Rack::Utils.escape_html(flow.name) %>
                    </a>
                    <% if targets.any? %>
                      <div class="small text-muted ms-4">
                        <i class="fas fa-arrow-right me-1"></i>
                        uscita verso
                        <% targets.each_with_index do |target, index| %>
                          <%= ', ' if index.positive? %><%= Rack::Utils.escape_html(target.name) %>
                          <% unless folder.automation_flows.include?(target) %>
                            <span class="badge bg-warning text-dark">fuori cartella</span>
                          <% end %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">
                      <%= flow.active_version ? 'pubblicato' : 'solo bozza' %>
                    </span>
                    <form method="post" action="/automations/<%= flow.id %>/duplicate">
                      <button class="btn btn-sm btn-outline-secondary" title="Duplica automazione">
                        <i class="fas fa-copy"></i>
                      </button>
                    </form>
                    <form method="post" action="/automation_folders/<%= folder.id %>/flows/<%= flow.id %>/delete">
                      <button class="btn btn-sm btn-outline-secondary" title="Rimuovi solo dalla cartella">
                        <i class="fas fa-folder-minus"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% end %>
              <% if rows.empty? %>
                <div class="text-muted small p-3">Nessun flusso inserito.</div>
              <% end %>
            </div>
            <div class="p-3 bg-light">
              <div class="d-flex flex-wrap gap-2 align-items-end justify-content-between">
                <form method="post" action="/automation_folders/<%= folder.id %>/flows" class="d-flex gap-2 align-items-end">
                  <div>
                    <label class="form-label small mb-1">Aggiungi o sposta un flusso qui</label>
                    <select class="form-select form-select-sm" name="automation_flow_id" required>
                      <option value="">-- Scegli flusso --</option>
                      <% @automation_flows.each do |flow| %>
                        <% unless folder.automation_flows.include?(flow) %>
                          <option value="<%= flow.id %>"><%= Rack::Utils.escape_html(flow.name) %></option>
                        <% end %>
                      <% end %>
                    </select>
                  </div>
                  <button class="btn btn-sm btn-outline-primary">Sposta qui</button>
                </form>
                <form method="post" action="/automation_folders/<%= folder.id %>/delete"
                      onsubmit="return confirm('Eliminare solo la cartella “<%= Rack::Utils.escape_html(folder.name) %>”? I flussi diventeranno non organizzati, senza modificare i collegamenti.');">
                  <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i>Elimina cartella</button>
                </form>
              </div>
            </div>
          </details>
        <% end %>
        <% if @automation_folders.empty? %>
          <div class="text-center text-muted py-4">
            Crea una cartella e scegli liberamente quali flussi inserirvi.
          </div>
        <% end %>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <strong>Flussi non organizzati</strong>
          <div class="small text-muted">Automazioni indipendenti che non appartengono ancora a un processo completo.</div>
        </div>
        <span class="badge bg-secondary"><%= @unorganized_flows.size %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Nome</th>
              <th>Stato</th>
              <th class="text-end"></th>
            </tr>
          </thead>
          <tbody>
            <% @unorganized_flows.each do |flow| %>
              <% linked_names = flow.linked_print_flows.map(&:name) %>
              <% module_names = flow.incoming_handoff_flows.map(&:name) %>
              <% runs_count = flow.runs_count %>
              <tr>
                <td>
                  <strong><%= Rack::Utils.escape_html(flow.name) %></strong>
                  <% if flow.description.present? %>
                    <div class="small text-muted"><%= Rack::Utils.escape_html(flow.description) %></div>
                  <% end %>
                </td>
                <td>
                  <span class="badge <%= flow.active_version ? 'bg-success' : 'bg-warning text-dark' %>">
                    <%= flow.active_version ? 'Pubblicato' : 'Bozza' %>
                  </span>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex gap-1">
                    <a class="btn btn-sm btn-outline-primary" href="/automations/<%= flow.id %>/edit">
                      <i class="fas fa-pen me-1"></i>Apri editor
                    </a>
                    <form method="post" action="/automations/<%= flow.id %>/duplicate">
                      <button class="btn btn-sm btn-outline-secondary" title="Duplica automazione">
                        <i class="fas fa-copy"></i>
                      </button>
                    </form>
                    <form method="post"
                          action="/automations/<%= flow.id %>/delete"
                          onsubmit="return confirm('Eliminare il flusso “<%= Rack::Utils.escape_html(flow.name) %>”<%= runs_count.positive? ? " e le sue #{runs_count} esecuzioni" : '' %>? L’operazione non può essere annullata.');">
                      <button class="btn btn-sm btn-outline-danger"
                              title="<%= if linked_names.any?
                                         "Prima scollega: #{Rack::Utils.escape_html(linked_names.join(', '))}"
                                       elsif module_names.any?
                                         "Prima rimuovi il richiamo da: #{Rack::Utils.escape_html(module_names.join(', '))}"
                                       else
                                         'Elimina flusso'
                                       end %>"
                              <%= 'disabled' if linked_names.any? || module_names.any? %>>
                        <i class="fas fa-trash me-1"></i>Elimina
                      </button>
                    </form>
                  </div>
                  <% if linked_names.any? %>
                    <div class="small text-muted mt-1">
                      Collegato a: <%= Rack::Utils.escape_html(linked_names.join(', ')) %>
                    </div>
                  <% end %>
                  <% if module_names.any? %>
                    <div class="small text-muted mt-1">
                      Modulo usato da: <%= Rack::Utils.escape_html(module_names.join(', ')) %>
                    </div>
                  <% end %>
                </td>
              </tr>
            <% end %>
            <% if @unorganized_flows.empty? %>
              <tr><td colspan="4" class="text-center text-muted py-5">Tutti i flussi sono organizzati in un processo.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if false %>
    <div class="card shadow-sm mt-4">
      <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Esecuzioni recenti</strong>
        <span class="badge bg-secondary"><%= @automation_runs.size %></span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>ID</th>
              <th>Flusso</th>
              <th>Ordine</th>
              <th>Stato</th>
              <th>Avvio</th>
            </tr>
          </thead>
          <tbody>
            <% @automation_runs.each do |run| %>
              <% badge = {'completed' => 'success', 'failed' => 'danger', 'waiting_external' => 'warning', 'waiting_review' => 'info'}.fetch(run.status, 'primary') %>
              <% modules_count = run.chain_runs.count - 1 %>
              <tr>
                <td><a href="/automation_runs/<%= run.id %>">#<%= run.id %></a></td>
                <td>
                  <%= Rack::Utils.escape_html(run.flow.name) %>
                  <% if modules_count.positive? %>
                    <div class="small text-muted">
                      <%= modules_count %> <%= modules_count == 1 ? 'modulo successivo' : 'moduli successivi' %>
                    </div>
                  <% end %>
                </td>
                <td><%= Rack::Utils.escape_html(run.context.dig('order', 'code').to_s) %></td>
                <td><span class="badge bg-<%= badge %>"><%= run.status %></span></td>
                <td><%= run.created_at.strftime('%d/%m/%Y %H:%M') %></td>
              </tr>
            <% end %>
            <% if @automation_runs.empty? %>
              <tr><td colspan="5" class="text-center text-muted py-4">Nessuna esecuzione.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% end %>
  </div>

  <div class="col-xl-4">
    <div class="card shadow-sm mb-4">
      <div class="card-header"><strong>Nuova cartella automazioni</strong></div>
      <div class="card-body">
        <form method="post" action="/automation_folders">
          <label class="form-label" for="new-folder-name">Nome cartella</label>
          <input class="form-control mb-3" id="new-folder-name" name="name" required
                 placeholder="Es. Produzione plettri">
          <div class="form-label">Flussi da organizzare</div>
          <div class="border rounded p-2 mb-2" style="max-height: 220px; overflow-y: auto">
            <% @automation_flows.each do |flow| %>
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="automation_flow_ids[]"
                       value="<%= flow.id %>" id="folder-flow-<%= flow.id %>">
                <label class="form-check-label" for="folder-flow-<%= flow.id %>">
                  <%= Rack::Utils.escape_html(flow.name) %>
                </label>
              </div>
            <% end %>
          </div>
          <div class="form-text mb-3">Se un flusso era in un’altra cartella, verrà spostato.</div>
          <label class="form-label" for="new-folder-description">Descrizione</label>
          <textarea class="form-control mb-3" id="new-folder-description" name="description" rows="2"></textarea>
          <button class="btn btn-outline-primary w-100">
            <i class="fas fa-folder-plus me-1"></i>Crea cartella
          </button>
        </form>
      </div>
    </div>

    <div class="card shadow-sm">
      <div class="card-header"><strong>Nuovo flusso</strong></div>
      <div class="card-body">
        <form method="post" action="/automations">
          <label class="form-label" for="new-flow-name">Nome</label>
          <input class="form-control mb-3" id="new-flow-name" name="name" required placeholder="Es. Etichette UV">
          <label class="form-label" for="new-flow-description">Descrizione</label>
          <textarea class="form-control mb-3" id="new-flow-description" name="description" rows="3"></textarea>
          <button class="btn btn-outline-primary w-100"><i class="fas fa-plus me-1"></i>Crea e modifica</button>
        </form>
      </div>
    </div>

    <div class="card shadow-sm mt-4">
      <div class="card-body d-flex justify-content-between align-items-center gap-3">
        <div>
          <strong>Macchine Adobe</strong>
          <div class="small text-muted"><%= @automation_agents.count(&:online?) %> online su <%= @automation_agents.size %></div>
        </div>
        <a class="btn btn-outline-secondary btn-sm" href="/automation_agents">
          <i class="fas fa-desktop me-1"></i>Configura
        </a>
      </div>
    </div>

    <% if false %>
    <div class="card shadow-sm mt-4">
      <div class="card-header"><strong>Preset riutilizzabili</strong></div>
      <div class="card-body">
        <% @automation_presets.each do |preset| %>
          <details class="border rounded p-2 mb-2">
            <summary>
              <span class="badge bg-light text-dark"><%= preset.kind == 'imposition' ? 'plancia' : Rack::Utils.escape_html(preset.kind) %></span>
              <strong><%= Rack::Utils.escape_html(preset.code) %></strong>
            </summary>
            <form method="post" action="/automations/presets" class="mt-3">
              <input type="hidden" name="id" value="<%= preset.id %>">
              <input type="hidden" name="kind" value="<%= Rack::Utils.escape_html(preset.kind) %>">
              <label class="form-label small">Codice</label>
              <input class="form-control form-control-sm mb-2" name="code" value="<%= Rack::Utils.escape_html(preset.code) %>" required>
              <label class="form-label small">Nome</label>
              <input class="form-control form-control-sm mb-2" name="name" value="<%= Rack::Utils.escape_html(preset.name) %>" required>
              <% if preset.kind == 'imposition' %>
                <% config = preset.config %>
                <% anchor = config['anchor'].presence || 'bottom_left' %>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="form-label small">Larghezza foglio (mm)</label>
                    <input class="form-control form-control-sm" type="number" step="0.01" min="0.01"
                           name="sheet_width_mm" value="<%= config['sheet_width_mm'] %>" required>
                  </div>
                  <div class="col-6">
                    <label class="form-label small">Altezza foglio (mm)</label>
                    <input class="form-control form-control-sm" type="number" step="0.01" min="0.01"
                           name="sheet_height_mm" value="<%= config['sheet_height_mm'] %>" required>
                  </div>
                </div>
                <label class="form-label small d-block">Punto di partenza</label>
                <div class="row g-1 mb-2">
                  <% [
                    ['top_left', '↖ Alto sinistra'],
                    ['top_right', 'Alto destra ↗'],
                    ['bottom_left', '↙ Basso sinistra'],
                    ['bottom_right', 'Basso destra ↘']
                  ].each do |value, label| %>
                    <div class="col-6">
                      <input class="btn-check" type="radio" name="anchor"
                             id="anchor-<%= preset.id %>-<%= value %>" value="<%= value %>"
                             <%= 'checked' if anchor == value %>>
                      <label class="btn btn-sm btn-outline-secondary w-100"
                             for="anchor-<%= preset.id %>-<%= value %>"><%= label %></label>
                    </div>
                  <% end %>
                </div>
                <div class="row g-2 mb-2">
                  <div class="col-6">
                    <label class="form-label small">Distanza orizzontale (mm)</label>
                    <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                           name="offset_x_mm" value="<%= config.fetch('offset_x_mm', 0) %>" required>
                  </div>
                  <div class="col-6">
                    <label class="form-label small">Distanza verticale (mm)</label>
                    <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                           name="offset_y_mm" value="<%= config.fetch('offset_y_mm', 0) %>" required>
                  </div>
                  <div class="col-6">
                    <label class="form-label small">Spazio orizzontale (mm)</label>
                    <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                           name="gap_x_mm" value="<%= config.fetch('gap_x_mm', 0) %>" required>
                  </div>
                  <div class="col-6">
                    <label class="form-label small">Spazio verticale (mm)</label>
                    <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                           name="gap_y_mm" value="<%= config.fetch('gap_y_mm', 0) %>" required>
                  </div>
                  <div class="col-6">
                    <label class="form-label small">Colonne fisse</label>
                    <input class="form-control form-control-sm" type="number" step="1" min="0"
                           name="columns" value="<%= config.fetch('columns', 0) %>" required>
                    <div class="form-text">0 = automatiche</div>
                  </div>
                  <div class="col-6">
                    <label class="form-label small">Righe fisse</label>
                    <input class="form-control form-control-sm" type="number" step="1" min="0"
                           name="rows" value="<%= config.fetch('rows', 0) %>" required>
                    <div class="form-text">0 = automatiche</div>
                  </div>
                </div>
                <div class="form-check">
                  <input type="hidden" name="rotate" value="0">
                  <input class="form-check-input" type="checkbox" name="rotate" value="1"
                         id="rotate-<%= preset.id %>" <%= 'checked' if config['rotate'] %>>
                  <label class="form-check-label small" for="rotate-<%= preset.id %>">Ruota tutti gli oggetti di 90°</label>
                </div>
                <div class="form-check mb-2">
                  <input type="hidden" name="fill_last_sheet" value="0">
                  <input class="form-check-input" type="checkbox" name="fill_last_sheet" value="1"
                         id="fill-<%= preset.id %>" <%= 'checked' if config['fill_last_sheet'] %>>
                  <label class="form-check-label small" for="fill-<%= preset.id %>">Completa l’ultima plancia ripetendo le pagine</label>
                </div>
                <div class="alert alert-light border small py-2">
                  Con valore 0, righe e colonne vengono calcolate dal PDF. Il contenuto non viene ridimensionato.
                </div>
              <% else %>
                <label class="form-label small">Configurazione JSON avanzata</label>
                <textarea class="form-control form-control-sm font-monospace mb-2" name="config" rows="9"><%= Rack::Utils.escape_html(JSON.pretty_generate(preset.config)) %></textarea>
              <% end %>
              <div class="form-check mb-2">
                <input type="hidden" name="active" value="0">
                <input class="form-check-input" type="checkbox" name="active" value="1" id="preset-<%= preset.id %>" <%= 'checked' if preset.active %>>
                <label class="form-check-label" for="preset-<%= preset.id %>">Attivo</label>
              </div>
              <button class="btn btn-sm btn-outline-secondary">Salva preset</button>
            </form>
          </details>
        <% end %>

        <details class="border rounded p-2 mt-3">
          <summary><i class="fas fa-plus me-1"></i>Nuovo preset plancia</summary>
          <form method="post" action="/automations/presets" class="mt-3">
            <input type="hidden" name="kind" value="imposition">
            <label class="form-label small">Codice</label>
            <input class="form-control form-control-sm mb-2" name="code" required placeholder="Es. PLETTRI_466X191">
            <label class="form-label small">Nome</label>
            <input class="form-control form-control-sm mb-2" name="name" required placeholder="Es. Plancia plettri">
            <div class="row g-2 mb-2">
              <div class="col-6">
                <label class="form-label small">Larghezza foglio (mm)</label>
                <input class="form-control form-control-sm" type="number" step="0.01" min="0.01" name="sheet_width_mm" required>
              </div>
              <div class="col-6">
                <label class="form-label small">Altezza foglio (mm)</label>
                <input class="form-control form-control-sm" type="number" step="0.01" min="0.01" name="sheet_height_mm" required>
              </div>
            </div>
            <label class="form-label small d-block">Punto di partenza</label>
            <div class="row g-1 mb-2">
              <% [
                ['top_left', '↖ Alto sinistra'],
                ['top_right', 'Alto destra ↗'],
                ['bottom_left', '↙ Basso sinistra'],
                ['bottom_right', 'Basso destra ↘']
              ].each do |value, label| %>
                <div class="col-6">
                  <input class="btn-check" type="radio" name="anchor"
                         id="new-anchor-<%= value %>" value="<%= value %>"
                         <%= 'checked' if value == 'top_left' %>>
                  <label class="btn btn-sm btn-outline-secondary w-100"
                         for="new-anchor-<%= value %>"><%= label %></label>
                </div>
              <% end %>
            </div>
            <div class="row g-2 mb-2">
              <% [
                ['offset_x_mm', 'Distanza orizzontale'],
                ['offset_y_mm', 'Distanza verticale'],
                ['gap_x_mm', 'Spazio orizzontale'],
                ['gap_y_mm', 'Spazio verticale']
              ].each do |field, label| %>
                <div class="col-6">
                  <label class="form-label small"><%= label %> (mm)</label>
                  <input class="form-control form-control-sm" type="number" step="0.01" min="0"
                         name="<%= field %>" value="0" required>
                </div>
              <% end %>
              <div class="col-6">
                <label class="form-label small">Colonne fisse</label>
                <input class="form-control form-control-sm" type="number" step="1" min="0"
                       name="columns" value="0" required>
                <div class="form-text">0 = automatiche</div>
              </div>
              <div class="col-6">
                <label class="form-label small">Righe fisse</label>
                <input class="form-control form-control-sm" type="number" step="1" min="0"
                       name="rows" value="0" required>
                <div class="form-text">0 = automatiche</div>
              </div>
            </div>
            <div class="form-check">
              <input type="hidden" name="rotate" value="0">
              <input class="form-check-input" type="checkbox" name="rotate" value="1" id="new-rotate">
              <label class="form-check-label small" for="new-rotate">Ruota tutti gli oggetti di 90°</label>
            </div>
            <div class="form-check mb-2">
              <input type="hidden" name="fill_last_sheet" value="0">
              <input class="form-check-input" type="checkbox" name="fill_last_sheet" value="1" id="new-fill">
              <label class="form-check-label small" for="new-fill">Completa l’ultima plancia</label>
            </div>
            <input type="hidden" name="active" value="1">
            <button class="btn btn-sm btn-outline-primary w-100">Crea preset plancia</button>
          </form>
        </details>

        <details class="border rounded p-2 mt-2">
          <summary><i class="fas fa-code me-1"></i>Nuovo preset tecnico</summary>
          <form method="post" action="/automations/presets" class="mt-3">
            <label class="form-label small">Tipo</label>
            <select class="form-select form-select-sm mb-2" name="kind">
              <option value="output">output</option>
              <option value="adobe">adobe</option>
              <option value="mask">mask</option>
            </select>
            <label class="form-label small">Codice</label>
            <input class="form-control form-control-sm mb-2" name="code" required>
            <label class="form-label small">Nome</label>
            <input class="form-control form-control-sm mb-2" name="name" required>
            <label class="form-label small">Configurazione JSON</label>
            <textarea class="form-control form-control-sm font-monospace mb-2" name="config" rows="6">{}</textarea>
            <input type="hidden" name="active" value="1">
            <button class="btn btn-sm btn-outline-secondary">Crea preset</button>
          </form>
        </details>
      </div>
    </div>
    <% end %>
  </div>
</div>
