<!-- Legacy editor kept inert while existing installations transition to the module below. -->
<script type="application/x-disabled">
(function() {
  let adjustAssetId = null;
  let originalImage = null;
  let currentOffsetX = 0;
  let currentOffsetY = 0;
  let currentZoom = 1;
  
  const adjustModal = document.getElementById('imageAdjustModal');
  const adjustCanvas = document.getElementById('adjustCanvas');
  const ctx = adjustCanvas ? adjustCanvas.getContext('2d') : null;
  const zoomSlider = document.getElementById('zoomSlider');
  const zoomInput = document.getElementById('zoomInput');
  const offsetXSlider = document.getElementById('offsetXSlider');
  const offsetYSlider = document.getElementById('offsetYSlider');
  const offsetXInput = document.getElementById('offsetXInput');
  const offsetYInput = document.getElementById('offsetYInput');
  const resetOffsetBtn = document.getElementById('resetOffsetBtn');
  const saveAdjustedImageBtn = document.getElementById('saveAdjustedImageBtn');
  
  function redrawCanvas() {
    if (!originalImage || !ctx) return;
    
    // Clear canvas with transparency
    ctx.clearRect(0, 0, adjustCanvas.width, adjustCanvas.height);
    
    // Save context state
    ctx.save();
    
    // Calculate centers
    const imgCenterX = originalImage.width / 2;
    const imgCenterY = originalImage.height / 2;
    const canvasCenterX = adjustCanvas.width / 2;
    const canvasCenterY = adjustCanvas.height / 2;
    
    // Translate to canvas center (pivot point for zoom)
    ctx.translate(canvasCenterX, canvasCenterY);
    
    // Apply zoom from center
    ctx.scale(currentZoom, currentZoom);
    
    // Translate to image center and apply offset
    ctx.translate(-imgCenterX + currentOffsetX / currentZoom, -imgCenterY + currentOffsetY / currentZoom);
    
    // Draw image (preserves transparency)
    ctx.drawImage(originalImage, 0, 0);
    
    // Draw grey background BEHIND image (doesn't overwrite transparency)
    ctx.globalCompositeOperation = 'destination-over';
    ctx.fillStyle = '#CCCCCC';
    ctx.fillRect(0, 0, originalImage.width, originalImage.height);
    
    // Reset composite operation
    ctx.globalCompositeOperation = 'source-over';
    ctx.restore();
  }
  
  function updateZoom(z) {
    currentZoom = parseFloat(z) || 1;
    currentZoom = Math.max(0.5, Math.min(2, currentZoom));
    
    zoomSlider.value = currentZoom;
    zoomInput.value = currentZoom.toFixed(2);
    
    redrawCanvas();
  }
  
  function updateOffsets(x, y) {
    currentOffsetX = parseInt(x) || 0;
    currentOffsetY = parseInt(y) || 0;
    
    offsetXSlider.value = Math.max(-200, Math.min(200, currentOffsetX));
    offsetYSlider.value = Math.max(-200, Math.min(200, currentOffsetY));
    offsetXInput.value = currentOffsetX;
    offsetYInput.value = currentOffsetY;
    
    redrawCanvas();
  }
  
  document.querySelectorAll('.btn-adjust-image').forEach(function(btn) {
    btn.addEventListener('click', function() {
      adjustAssetId = this.getAttribute('data-asset-id');
      const fileUrl = this.getAttribute('data-file-url');
      
      // Reset all values when opening modal
      currentOffsetX = 0;
      currentOffsetY = 0;
      currentZoom = 1;
      updateOffsets(0, 0);
      updateZoom(1);
      
      originalImage = new Image();
      originalImage.crossOrigin = 'anonymous';
      originalImage.onload = function() {
        adjustCanvas.width = originalImage.width;
        adjustCanvas.height = originalImage.height;
        redrawCanvas();
        
        const modal = new bootstrap.Modal(adjustModal);
        modal.show();
      };
      originalImage.onerror = function() {
        alert('Errore nel caricamento dell\'immagine');
      };
      originalImage.src = fileUrl;
    });
  });
  
  if (zoomSlider) {
    zoomSlider.addEventListener('input', function() {
      updateZoom(this.value);
    });
  }
  
  if (zoomInput) {
    zoomInput.addEventListener('input', function() {
      updateZoom(this.value);
    });
    zoomInput.addEventListener('change', function() {
      updateZoom(this.value);
    });
  }
  
  if (offsetXSlider) {
    offsetXSlider.addEventListener('input', function() {
      updateOffsets(this.value, currentOffsetY);
    });
  }
  
  if (offsetYSlider) {
    offsetYSlider.addEventListener('input', function() {
      updateOffsets(currentOffsetX, this.value);
    });
  }
  
  if (offsetXInput) {
    offsetXInput.addEventListener('change', function() {
      updateOffsets(this.value, currentOffsetY);
    });
  }
  
  if (offsetYInput) {
    offsetYInput.addEventListener('change', function() {
      updateOffsets(currentOffsetX, this.value);
    });
  }
  
  if (resetOffsetBtn) {
    resetOffsetBtn.addEventListener('click', function() {
      updateOffsets(0, 0);
      updateZoom(1);
    });
  }
  
  if (saveAdjustedImageBtn) {
    saveAdjustedImageBtn.addEventListener('click', function() {
      if (!adjustAssetId || !adjustCanvas || !originalImage) return;
      
      this.disabled = true;
      this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Salvando...';
      
      // Create temporary canvas with ORIGINAL dimensions (no upscaling)
      // Zoomed content will be cropped from CENTER (not from top-left)
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = adjustCanvas.width;  // Keep original canvas size (e.g., 1000x1000)
      tempCanvas.height = adjustCanvas.height;
      const tempCtx = tempCanvas.getContext('2d');
      
      // Calculate center point for cropping
      const centerX = tempCanvas.width / 2;
      const centerY = tempCanvas.height / 2;
      
      // Translate to center, apply zoom, then translate back
      tempCtx.translate(centerX, centerY);
      tempCtx.scale(currentZoom, currentZoom);
      tempCtx.translate(-centerX, -centerY);
      
      // Draw the image with offset applied (zoom is applied via context transform)
      tempCtx.drawImage(
        originalImage,
        currentOffsetX, currentOffsetY
      );
      
      // Export as PNG (preserves alpha transparency)
      const imageData = tempCanvas.toDataURL('image/png');
      
      fetch('/assets/' + adjustAssetId + '/adjust', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          image_data: imageData,
          offset_x: currentOffsetX,
          offset_y: currentOffsetY,
          zoom: currentZoom
        })
      })
      .then(function(response) { return response.json(); })
      .then(function(data) {
        if (data.success) {
          bootstrap.Modal.getInstance(adjustModal).hide();
          window.location.reload();
        } else {
          alert('Errore: ' + (data.error || 'Salvataggio fallito'));
          saveAdjustedImageBtn.disabled = false;
          saveAdjustedImageBtn.innerHTML = '<i class="fas fa-save"></i> Salva Immagine';
        }
      })
      .catch(function(error) {
        alert('Errore di rete: ' + error.message);
        saveAdjustedImageBtn.disabled = false;
        saveAdjustedImageBtn.innerHTML = '<i class="fas fa-save"></i> Salva Immagine';
      });
    });
  }
})();
</script>

<script type="module" src="/image_editor.js?v=8"></script>

<!-- Auto-refresh preprint result section -->
<script>
  let pollingInterval = null;
  let lastKnownStatus = '<%= @item.preprint_status %>';
  
  function pollPreprintResult() {
    const orderId = '<%= @order.id %>';
    const itemId = '<%= @item.id %>';
    const preprintResultSection = document.getElementById('preprint-result-section');
    
    if (!preprintResultSection) return; // Section doesn't exist
    
    // Fetch the updated section and get the current status from the server
    fetch(`/orders/${orderId}/items/${itemId}/preprint_result_section`)
      .then(response => response.text())
      .then(html => {
        preprintResultSection.innerHTML = html;
        
        // Check if we got content (means preprint is processing or completed)
        if (html.trim() !== '') {
          console.log('[POLLING] Result section updated');
        }
      })
      .catch(error => {
        console.error('[POLLING] Error fetching preprint result:', error);
      });
  }
  
  function checkStatusAndContinuePolling() {
    const orderId = '<%= @order.id %>';
    const itemId = '<%= @item.id %>';
    
    // Fetch the item detail to check current status
    fetch(`/orders/${orderId}/items/${itemId}`)
      .then(response => response.text())
      .then(html => {
        // Extract status from the response (simple approach: check if preprint_status appears in certain state)
        // If content contains "Elaborando" or "Result" button, keep polling
        // If content shows only pending state, stop polling
        
        // Continue polling as long as preprint is not pending (i.e., it's processing or completed)
        // Stop polling only when reset (back to pending with no file)
        const hasProcessingOrResult = html.includes('Elaborando') || html.includes('Switch result');
        
        if (hasProcessingOrResult) {
          // Continue polling
          return true;
        } else {
          // Stop polling (back to pending)
          return false;
        }
      })
      .catch(error => {
        console.error('[POLLING] Error checking status:', error);
        // Continue polling on error
        return true;
      })
      .then(shouldContinue => {
        if (!shouldContinue && pollingInterval) {
          clearInterval(pollingInterval);
          pollingInterval = null;
          console.log('[POLLING] Stopped - item reset to pending');
        }
      });
  }
  
  // Start polling on page load
  document.addEventListener('DOMContentLoaded', function() {
    pollPreprintResult(); // Initial call
    
    const initialStatus = '<%= @item.preprint_status %>';
    if (initialStatus !== 'pending') {
      // Start continuous polling that will automatically stop when reset
      pollingInterval = setInterval(function() {
        pollPreprintResult();
        checkStatusAndContinuePolling();
      }, 3000);
    }
  });

  // Poll print result section
  let printPollingInterval = null;
  
  function pollPrintResult() {
    const orderId = '<%= @order.id %>';
    const itemId = '<%= @item.id %>';
    const printResultSection = document.getElementById('print-result-section');
    
    if (!printResultSection) return;
    
    fetch(`/orders/${orderId}/items/${itemId}/print_result_section`)
      .then(response => response.text())
      .then(html => {
        printResultSection.innerHTML = html;
      })
      .catch(error => {
        console.error('[POLLING] Error fetching print result:', error);
      });
  }
  
  function checkPrintStatusAndContinuePolling() {
    const orderId = '<%= @order.id %>';
    const itemId = '<%= @item.id %>';
    
    fetch(`/orders/${orderId}/items/${itemId}`)
      .then(response => response.text())
      .then(html => {
        const hasProcessingOrResult = html.includes('Elaborando') || html.includes('print_result');
        return hasProcessingOrResult;
      })
      .catch(error => {
        console.error('[POLLING] Error checking print status:', error);
        return true;
      })
      .then(shouldContinue => {
        if (!shouldContinue && printPollingInterval) {
          clearInterval(printPollingInterval);
          printPollingInterval = null;
          console.log('[POLLING] Print polling stopped');
        }
      });
  }
  
  // Start print polling if needed
  document.addEventListener('DOMContentLoaded', function() {
    const initialPrintStatus = '<%= @item.print_status %>';
    if (initialPrintStatus !== 'pending') {
      pollPrintResult();
      printPollingInterval = setInterval(function() {
        pollPrintResult();
        checkPrintStatusAndContinuePolling();
      }, 3000);
    }
  });
</script>
