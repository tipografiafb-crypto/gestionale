<div class="mb-4">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/orders">Ordini</a></li>
      <li class="breadcrumb-item"><a href="/orders/<%= @order.id %>"><%= @order.external_order_code %></a></li>
      <li class="breadcrumb-item active"><a href="/orders/<%= @order.id %>/items/<%= @item.id %>">Lavoro <%= @item.id %></a></li>
    </ol>
  </nav>
</div>

<!-- INTESTAZIONE 2 COLONNE -->
<div class="row mb-4">
  <!-- Sinistra: Info -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <strong>Informazioni Lavoro</strong>
      </div>
      <div class="card-body">
        <table class="table table-sm table-borderless">
          <tr>
            <th>Codice Ordine:</th>
            <td><strong><%= @order.external_order_code %></strong></td>
          </tr>
          <tr>
            <th>Prodotto:</th>
            <td><strong><%= @item.product&.name || @item.sku %></strong></td>
          </tr>
          <tr>
            <th>Quantità:</th>
            <td><strong><%= @item.quantity %></strong></td>
          </tr>
          <% design_rows = @item.design_group_items %>
          <tr>
            <th>Grafica condivisa:</th>
            <td>
              <span class="badge bg-info text-dark"><%= @item.effective_design_group_key.to_s.split(':').last[0, 12].upcase %></span>
              <% if design_rows.length > 1 %>
                <small class="d-block text-muted mt-1">
                  <%= design_rows.map { |row| "#{row.sku} × #{row.quantity}" }.join(' · ') %>
                </small>
                <small class="d-block text-success mt-1"><i class="fas fa-link"></i> Modifiche, prestampa, stampa e conferme vengono applicate alle taglie collegate.</small>
              <% else %>
                <small class="d-block text-muted mt-1">Nessun’altra taglia collegata</small>
              <% end %>
            </td>
          </tr>
          <tr>
            <th>Negozio:</th>
            <td><%= @order.store.code %></td>
          </tr>
          <tr>
            <td colspan="2">
              <a href="/orders/<%= @order.id %>/items/<%= @item.id %>/print" class="btn btn-outline-info w-100" target="_blank">
                <i class="fas fa-file-invoice"></i> Scheda Lavoro
              </a>
              <% if @latest_automation_run %>
                <a href="/automation_runs/<%= @latest_automation_run.id %>"
                   class="btn btn-outline-secondary w-100 mt-2" target="_blank" rel="noopener"
                   title="Apri il debug dell'ultima esecuzione del flusso">
                  <i class="fas fa-bug"></i> Debug ultima esecuzione
                  <span class="badge bg-<%= @latest_automation_run.status == 'failed' ? 'danger' : (@latest_automation_run.status == 'completed' ? 'success' : 'secondary') %> ms-1"><%= @latest_automation_run.status %></span>
                </a>
              <% end %>
            </td>
          </tr>
        </table>
      </div>
    </div>
  </div>

  <!-- Destra: Product Image Preview (NOT print files) -->
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <strong>Immagini Prodotto</strong>
      </div>
      <div class="card-body text-center">
        <% product_images = @item.assets.select { |a| a.downloaded? && a.asset_type&.start_with?('screenshot') && a.local_path_full.to_s.match?(/\.(png|jpg|jpeg|gif|webp)$/i) } %>
        <% if product_images.any? %>
          <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;">
            <% product_images.each do |asset| %>
              <button type="button" class="btn-preview-image" data-bs-toggle="modal" data-bs-target="#previewModal" data-file-url="/file/<%= asset.id %>" data-file-type="image" style="border: none; background: none; padding: 0; cursor: pointer;">
                <img src="/file/<%= asset.id %>" alt="<%= asset.asset_type %>" style="width: 100%; height: auto; cursor: pointer; border-radius: 4px;">
              </button>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">Nessuna immagine prodotto disponibile</p>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- BLOCCO PRINCIPALE: FLUSSO DI STAMPA -->
<div class="card mb-4">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <strong>Flusso di Stampa</strong>
    </div>
    <div style="display: flex; gap: 30px; align-items: center; font-size: 14px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <span>🖨️</span>
        <div>
          <% if @item.preprint_completed_at %>
            <small class="text-muted"><strong>Fine:</strong> <%= @item.preprint_completed_at.strftime('%d-%m-%y %H:%M') %></small>
          <% elsif @item.preprint_status == 'failed' %>
            <span class="badge bg-danger">Errore</span>
          <% end %>
        </div>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span><i class="fas fa-check-circle"></i></span>
        <div>
          <% if @item.print_completed_at %>
            <small class="text-muted"><strong>Fine:</strong> <%= @item.print_completed_at.strftime('%d-%m-%y %H:%M') %></small>
          <% elsif @item.print_status == 'failed' %>
            <span class="badge bg-danger">Errore</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <div class="card-body">
    <!-- Action Buttons - Sopra Print Files -->
    <% available_machines = @item.print_flow&.print_machines || [] %>
    <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px;">
      <!-- Pre-stampa -->
      <button type="button" class="btn btn-outline-warning" 
              title="Configura e invia a Pre-stampa"
              data-bs-toggle="modal" data-bs-target="#flowSelectModal"
              <%= 'disabled' if @item.preprint_completed_at %>>
<i class="fas fa-print"></i> Pre-stampa
        <% if @item.preprint_status != 'pending' %>
          <span class="badge <%= @item.preprint_status == 'completed' ? 'bg-success' : 'bg-secondary' %>">
            <%= @item.preprint_status&.upcase %>
          </span>
        <% end %>
      </button>

      <!-- Stampa -->
      <button type="button" class="btn btn-outline-success" 
              data-bs-toggle="modal" data-bs-target="#machineSelectModal"
              <%= 'disabled' if @item.print_completed_at %>>
<i class="fas fa-check-circle"></i> Stampa
        <% if @item.print_status != 'pending' %>
          <span class="badge <%= @item.print_status == 'completed' ? 'bg-success' : 'bg-secondary' %>">
            <%= @item.print_status&.upcase %>
          </span>
        <% end %>
      </button>

      <!-- Etichetta -->
      <% if @item.print_flow && @item.print_flow.executor_for('label') != 'none' %>
        <button type="button" class="btn btn-outline-primary" 
                data-bs-toggle="modal" data-bs-target="#labelMachineSelectModal">
<i class="fas fa-tag"></i> Etichetta
        </button>
      <% end %>

      <!-- Reset -->
      <form action="/orders/<%= @order.id %>/items/<%= @item.id %>/reset" method="post" class="d-inline" onsubmit="return confirm('Resettare questo lavoro?');">
        <button type="submit" class="btn btn-outline-secondary" 
                <%= 'disabled' if @item.preprint_status == 'pending' && @item.print_status == 'pending' %>>
<i class="fas fa-redo"></i> Ripristina
        </button>
      </form>
    </div>

    <!-- Pre-stampa Result Section -->
    <div id="preprint-result-section" style="margin-top: 15px; margin-bottom: 15px; padding: 15px; border: 1px solid #ddd; border-radius: 4px;">
      <!-- Populated by polling: shows processing bar until Switch sends file, then shows result button -->
    </div>

    <!-- Stampa Result Section -->
    <div id="print-result-section" style="margin-top: 15px; margin-bottom: 15px; padding: 15px; border: 1px solid #ddd; border-radius: 4px;">
      <!-- Populated by polling: shows processing bar until Switch sends file, then shows result button -->
    </div>

    <!-- File di Stampa e Azioni -->
    <div class="row">
      <div class="col-md-12">
        <h6>File di Stampa e Azioni:</h6>
        
        <% print_files = @item.assets.select { |a| a.asset_type&.start_with?('print_file') } %>
        <% if print_files.any? %>
          <div class="row mb-3">
            <% print_files.each do |asset| %>
              <% asset_label = asset.asset_type == 'print_file_halftone' ? 'Retino DTF' : 'File di Stampa' %>
              <div class="col-md-3 mb-3">
                <div class="card">
                  <div class="card-body text-center">
                    <% if asset.downloaded? && asset.local_path_full.to_s.match?(/\.(png|jpg|jpeg|gif|webp)$/i) %>
                      <button type="button" class="btn-preview-image" data-bs-toggle="modal" data-bs-target="#previewModal" data-file-url="/file/<%= asset.id %>" data-file-type="image" style="border: none; background: none; padding: 0; cursor: pointer;">
                        <img src="/file/<%= asset.id %>" alt="<%= asset.asset_type %>" style="width: 50%; height: auto; cursor: pointer; border-radius: 4px; margin-bottom: 8px;">
                      </button>
                    <% else %>
                      <div style="background-color: #f0f0f0; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 4px; margin-bottom: 8px; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#previewModal" data-file-url="/file/<%= asset.id %>" data-file-type="pdf">
                        <i class="fas fa-file-pdf" style="font-size: 32px; color: #dc3545;"></i>
                      </div>
                    <% end %>
                    <small class="d-block"><strong><%= asset_label %></strong></small>
                    <% if (png_info = png_print_info(asset)) %>
                      <small class="d-block text-muted">
                        <%= png_info[:width_px] %>x<%= png_info[:height_px] %> px -
                        <%= format('%.1f', png_info[:print_width_cm]) %>x<%= format('%.1f', png_info[:print_height_cm]) %> cm @ <%= png_info[:target_dpi] %> DPI
                      </small>
                      <% if png_info[:declared_dpi] && (png_info[:declared_dpi] - png_info[:target_dpi]).abs > 1 %>
                        <small class="d-block text-warning">DPI file: <%= png_info[:declared_dpi].round %>, pixel invariati</small>
                      <% end %>
                    <% end %>
                    <div class="btn-group btn-group-sm mt-2" role="group">
                      <% if asset.downloaded? %>
                        <a href="/assets/<%= asset.id %>/download" class="btn btn-sm btn-outline-primary" title="Scarica"><i class="fas fa-download"></i></a>
                        <% if asset.local_path_full.to_s.match?(/\.png$/i) %>
                          <button type="button" class="btn btn-sm btn-outline-warning btn-adjust-image" 
                                  data-asset-id="<%= asset.id %>" 
                                  title="Editor immagine"><i class="fas fa-crop-alt"></i></button>
                          <% if asset.local_path_full.to_s.match?(/\.png$/i) && asset.asset_type != 'print_file_halftone' %>
                            <a href="/assets/<%= asset.id %>/halftone" class="btn btn-sm btn-outline-success" title="Configura retino DTF"><i class="fas fa-dot-circle"></i></a>
                          <% end %>
                          <form action="/assets/<%= asset.id %>/restore" method="post" class="d-inline" onsubmit="return confirm('Ripristinare la versione originale dell\'immagine?');">
                            <input type="hidden" name="order_id" value="<%= @order.id %>">
                            <input type="hidden" name="item_id" value="<%= @item.id %>">
                            <button type="submit" class="btn btn-sm btn-outline-info" title="Ripristina originale"><i class="fas fa-history"></i></button>
                          </form>
                        <% end %>
                        <form action="/assets/<%= asset.id %>/delete" method="post" class="d-inline">
                          <input type="hidden" name="order_id" value="<%= @order.id %>">
                          <input type="hidden" name="item_id" value="<%= @item.id %>">
                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Elimina" onclick="return confirm('Cancellare questo file?');"><i class="fas fa-trash"></i></button>
                        </form>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <p class="text-muted">Nessun file di stampa caricato. Carica file per inviarli al flusso di stampa.</p>
        <% end %>

        <!-- Upload Files Form -->
        <div class="card mb-4" style="background-color: var(--neutral-50); border: 2px dashed var(--neutral-300);">
          <div class="card-body">
            <h6 class="mb-3"><i class="fas fa-cloud-upload-alt"></i> Carica File di Stampa</h6>
            <form action="/orders/<%= @order.id %>/items/<%= @item.id %>/upload" method="post" enctype="multipart/form-data">
              <div style="display: flex; gap: 10px; align-items: center;">
                <input type="file" name="file" accept=".png,.jpg,.jpeg,.pdf,.gif,.webp" required style="flex: 1;">
                <button type="submit" class="btn btn-primary">
                  <i class="fas fa-upload"></i> Carica
                </button>
              </div>
            </form>
            <small class="text-muted d-block mt-2">PNG, JPG, PDF, GIF, WebP (max 50MB)</small>
          </div>
        </div>

        <!-- Cut Files Section (File di Taglio) -->
        <% cut_files = @item.assets.select { |a| a.asset_type == 'cut' } %>
        <% if cut_files.any? || @item.product&.has_cut_file %>
          <div class="mt-4">
            <h6><i class="fas fa-cut"></i> File di Taglio:</h6>
            
            <% if cut_files.any? %>
              <div class="row mb-3">
                <% cut_files.each do |asset| %>
                  <div class="col-md-3 mb-3">
                    <div class="card">
                      <div class="card-body text-center">
                        <div style="background-color: #f0f0f0; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 4px; margin-bottom: 8px;">
                          <i class="fas fa-vector-square" style="font-size: 32px; color: #6f42c1;"></i>
                        </div>
                        <small class="d-block"><strong>File di Taglio</strong></small>
                        <small class="text-muted d-block text-truncate" title="<%= File.basename(asset.original_url || '') %>">
                          <%= File.basename(asset.original_url || 'cut-file.svg') %>
                        </small>
                        <div class="btn-group btn-group-sm mt-2" role="group">
                          <% if asset.downloaded? %>
                            <a href="/assets/<%= asset.id %>/download" class="btn btn-sm btn-outline-primary" title="Scarica"><i class="fas fa-download"></i></a>
                          <% else %>
                            <a href="<%= asset.original_url %>" class="btn btn-sm btn-outline-primary" title="Scarica da URL" target="_blank"><i class="fas fa-external-link-alt"></i></a>
                          <% end %>
                          <form action="/assets/<%= asset.id %>/delete" method="post" class="d-inline">
                            <input type="hidden" name="order_id" value="<%= @order.id %>">
                            <input type="hidden" name="item_id" value="<%= @item.id %>">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Elimina" onclick="return confirm('Cancellare questo file di taglio?');"><i class="fas fa-trash"></i></button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <p class="text-muted">Nessun file di taglio disponibile per questo lavoro.</p>
            <% end %>

            <!-- Upload Cut File Form -->
            <div class="card" style="background-color: #f8f5ff; border: 2px dashed #6f42c1;">
              <div class="card-body">
                <h6 class="mb-3"><i class="fas fa-cloud-upload-alt"></i> Carica File di Taglio</h6>
                <form action="/orders/<%= @order.id %>/items/<%= @item.id %>/upload_cut" method="post" enctype="multipart/form-data">
                  <div style="display: flex; gap: 10px; align-items: center;">
                    <input type="file" name="file" accept=".svg,.pdf,.dxf,.ai,.eps" required style="flex: 1;">
                    <button type="submit" class="btn btn-outline-primary" style="border-color: #6f42c1; color: #6f42c1;">
                      <i class="fas fa-upload"></i> Carica
                    </button>
                  </div>
                </form>
                <small class="text-muted d-block mt-2">SVG, PDF, DXF, AI, EPS (max 50MB)</small>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- MODALS -->

<!-- Modal: Select Print Flow -->
<div class="modal fade" id="flowSelectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="fas fa-print"></i> Pre-stampa - Configura</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/orders/<%= @order.id %>/items/<%= @item.id %>/send_preprint" method="post">
        <div class="modal-body">
          <% if @item.available_print_flows.count > 0 %>
            <div class="mb-3">
              <label class="form-label"><strong>Flusso di Stampa</strong></label>
              <% @item.available_print_flows.each do |flow| %>
                <div class="form-check mb-2">
                  <input class="form-check-input" type="radio" name="print_flow_id" 
                         value="<%= flow.id %>" id="flow_<%= flow.id %>"
                         data-flow-id="<%= flow.id %>"
                         onchange="updateAzionPhotoshopOptions(this)"
                         <%= 'checked' if flow.id == @item.product&.default_print_flow_id %>>
                  <label class="form-check-label" for="flow_<%= flow.id %>">
                    <strong><%= flow.name %></strong>
                    <% if flow.id == @item.product&.default_print_flow_id %>
                      <span class="badge bg-info">Predefinito</span>
                    <% end %>
                  </label>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="alert alert-warning">Nessun flusso di stampa disponibile</div>
          <% end %>

          <% if @item.product&.allow_preprint_quantity_override %>
            <div class="mb-3">
              <label for="preprint_quantity" class="form-label"><strong><i class="fas fa-boxes"></i> Quantità prestampa</strong></label>
              <input type="number" class="form-control" id="preprint_quantity" name="preprint_quantity"
                     min="1" step="1" placeholder="Lascia vuoto per usare <%= @item.quantity %>">
              <small class="text-muted">Quantità ordinata: <%= @item.quantity %>. Il valore modifica solo questa lavorazione, non l'ordine.</small>
            </div>
          <% end %>
          
          <div id="azione-photoshop-container" class="mb-3" style="display: none;">
            <label for="azione_photoshop" class="form-label"><strong><i class="fas fa-palette"></i> Azione Photoshop</strong></label>
            <select class="form-select" id="azione_photoshop" name="azione_photoshop">
              <option value="">-- Seleziona azione --</option>
            </select>
            <small class="text-muted">Valore da inviare a Switch</small>
          </div>

          <script>
            function updateAzionPhotoshopOptions(radioElement) {
              const flowId = radioElement.value;
              const container = document.getElementById('azione-photoshop-container');
              const select = document.getElementById('azione_photoshop');
              
              if (!flowId) {
                container.style.display = 'none';
                return;
              }
              
              // Fetch azione photoshop options for this flow
              fetch(`/api/print_flows/${flowId}/azione_photoshop_options`)
                .then(response => response.json())
                .then(data => {
                  select.innerHTML = '<option value="">-- Seleziona azione --</option>';
                  
                  if (data.enabled && data.options.length > 0) {
                    data.options.forEach(option => {
                      const opt = document.createElement('option');
                      opt.value = option;
                      opt.textContent = option;
                      if (option === data.default) {
                        opt.selected = true;
                      }
                      select.appendChild(opt);
                    });
                    container.style.display = 'block';
                  } else {
                    container.style.display = 'none';
                  }
                })
                .catch(error => {
                  console.error('Error loading azione photoshop options:', error);
                  container.style.display = 'none';
                });
            }
            
            // Initialize on page load
            const checkedFlow = document.querySelector('input[name="print_flow_id"]:checked');
            if (checkedFlow) {
              updateAzionPhotoshopOptions(checkedFlow);
            }
          </script>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
          <button type="submit" class="btn btn-warning">🖨️ Invia a Pre-stampa<%= " (#{design_rows.length} righe)" if design_rows.length > 1 %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Select Machine -->
<div class="modal fade" id="machineSelectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Scegli Stampante</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/orders/<%= @order.id %>/items/<%= @item.id %>/send_print" method="post">
        <div class="modal-body">
          <p class="text-muted mb-3">Seleziona stampante per questo lavoro:</p>
          <% available_machines.each do |machine| %>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="print_machine_id" 
                     value="<%= machine.id %>" id="machine_<%= machine.id %>"
                     <%= 'checked' if available_machines.first.id == machine.id %>>
              <label class="form-check-label" for="machine_<%= machine.id %>">
                <strong><%= machine.name %></strong>
                <% if machine.description %>
                  <br><small class="text-muted"><%= machine.description %></small>
                <% end %>
              </label>
            </div>
          <% end %>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
          <button type="submit" class="btn btn-success"><i class="fas fa-check-circle"></i> Invia a Stampa<%= " (#{design_rows.length} righe)" if design_rows.length > 1 %></button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal: Select Machine for Label -->
<div class="modal fade" id="labelMachineSelectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Scegli Stampante per Etichetta</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form action="/orders/<%= @order.id %>/items/<%= @item.id %>/send_label" method="post">
        <div class="modal-body">
          <p class="text-muted mb-3">Seleziona stampante per questa etichetta:</p>
          <% label_machines = available_machines.select { |machine| machine.active? && machine.label_automation_destination&.active? } %>
          <% label_machines.each do |machine| %>
            <div class="form-check mb-2">
              <input class="form-check-input" type="radio" name="print_machine_id" 
                     value="<%= machine.id %>" id="label_machine_<%= machine.id %>"
                     <%= 'checked' if label_machines.first.id == machine.id %>>
              <label class="form-check-label" for="label_machine_<%= machine.id %>">
                <strong><%= machine.name %></strong>
                <span class="text-muted">→ <%= machine.label_automation_destination.name %></span>
                <% if machine.description %>
                  <br><small class="text-muted"><%= machine.description %></small>
                <% end %>
              </label>
            </div>
          <% end %>
          <% if label_machines.empty? %>
            <div class="alert alert-warning mb-0">
              Nessuna stampante etichette è associata alle macchine disponibili.
              Configurala in <a href="/admin/print_machines">Macchine da stampa</a>.
            </div>
          <% end %>
        </div>
        <div class="modal-footer">
