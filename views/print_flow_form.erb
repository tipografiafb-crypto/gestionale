<div class="container mt-5" style="max-width: 600px;">
  <h1><%= @flow&.id ? "Modifica Flusso di Stampa" : "Nuovo Flusso di Stampa" %></h1>

  <% if @error %>
    <div class="alert alert-danger"><%= @error %></div>
  <% end %>

  <form action="<%= @flow&.id ? "/print_flows/#{@flow.id}" : "/print_flows" %>" method="post">
    <% if @flow&.id %>
      <input type="hidden" name="_method" value="PUT">
    <% end %>

    <div class="mb-3">
      <label for="name" class="form-label">Nome Flusso *</label>
      <input type="text" class="form-control" id="name" name="name" value="<%= @flow&.name %>" required>
      <small class="text-muted">Es: "Pre-press → Print Color", "B&W Production"</small>
    </div>

    <% [
      ['preprint', 'Pre-stampa', (@flow&.preprint_executor || 'webhook'), false],
      ['print', 'Stampa', (@flow&.print_executor || 'webhook'), false],
      ['label', 'Etichetta', (@flow&.label_executor || 'none'), true]
    ].each do |action, title, selected_executor, optional| %>
      <div class="card mb-3 action-destination" data-action="<%= action %>">
        <div class="card-header">
          <strong><%= title %></strong>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="<%= action %>_executor">Esecutore</label>
            <select class="form-select action-executor" id="<%= action %>_executor" name="<%= action %>_executor">
              <% if optional %><option value="none" <%= 'selected' if selected_executor == 'none' %>>Non configurata</option><% end %>
              <option value="webhook" <%= 'selected' if selected_executor == 'webhook' %>>Webhook Switch</option>
              <option value="automation" <%= 'selected' if selected_executor == 'automation' %>>Flusso interno</option>
            </select>
          </div>

          <div class="executor-fields" data-executor="webhook">
            <label class="form-label" for="<%= action %>_webhook_id">Webhook Switch</label>
            <select class="form-select destination-select" id="<%= action %>_webhook_id" name="<%= action %>_webhook_id">
              <option value="">-- Seleziona webhook --</option>
              <% @webhooks.each do |webhook| %>
                <option value="<%= webhook.id %>" <%= 'selected' if @flow&.public_send("#{action}_webhook_id") == webhook.id %>>
                  <%= webhook.name %> (<%= webhook.hook_path %>)
                </option>
              <% end %>
            </select>
          </div>

          <div class="executor-fields" data-executor="automation">
            <label class="form-label" for="<%= action %>_automation_flow_id">Flusso interno</label>
            <select class="form-select destination-select" id="<%= action %>_automation_flow_id" name="<%= action %>_automation_flow_id">
              <option value="">-- Seleziona flusso pubblicato --</option>
              <% @automation_flows.each do |automation| %>
                <option value="<%= automation.id %>"
                        <%= 'selected' if @flow&.public_send("#{action}_automation_flow_id") == automation.id %>
                        <%= 'disabled' unless automation.active_version %>>
                  <%= automation.name %><%= automation.active_version ? " · v#{automation.active_version.version_number}" : ' · non pubblicato' %>
                </option>
              <% end %>
            </select>
            <div class="form-text">
              L'azione avvia il flusso per ogni file della riga. In locale Photoshop e Illustrator vengono simulati.
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @flow&.id %>
    <div class="mb-3 p-3 bg-light border rounded">
      <label class="form-label fw-bold"><i class="fas fa-wrench"></i> Macchine da Stampa Disponibili</label>
      <p class="text-muted small mb-2">Seleziona le macchine disponibili per questo flusso</p>
      
      <% if @machines.any? %>
        <div class="list-group" style="max-height: 300px; overflow-y: auto;">
          <% @machines.each do |machine| %>
            <label class="list-group-item">
              <input type="checkbox" name="machine_ids[]" value="<%= machine.id %>" 
                     <%= 'checked' if @flow.print_machines.include?(machine) %>>
              <strong><%= machine.name %></strong>
              <% if machine.description %>
                <br><small class="text-muted"><%= machine.description %></small>
              <% end %>
            </label>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-info small mb-0">
          Nessuna macchina configurata. <a href="/admin/print_machines">Crea una macchina</a>
        </div>
      <% end %>
    </div>
    <% end %>

    <div class="mb-3">
      <label for="notes" class="form-label">Note</label>
      <textarea class="form-control" id="notes" name="notes" rows="2"><%= @flow&.notes %></textarea>
    </div>

    <div class="card mb-3">
      <div class="card-header">
        <h5><i class="fas fa-palette"></i> Azione Photoshop (Opzionale)</h5>
      </div>
      <div class="card-body">
        <div class="form-check mb-3">
          <input class="form-check-input" type="checkbox" id="azione_photoshop_enabled" 
                 name="azione_photoshop_enabled" value="1"
                 <%= 'checked' if @flow&.azione_photoshop_enabled %>>
          <label class="form-check-label" for="azione_photoshop_enabled">
            <strong>Abilita Azione Photoshop</strong>
          </label>
          <small class="d-block text-muted mt-1">Attiva il selettore di azione photoshop durante la pre-stampa</small>
        </div>

        <div id="azione-photoshop-options" style="<%= 'display: none;' unless @flow&.azione_photoshop_enabled %>">
          <div class="mb-3">
            <label for="azione_photoshop_options" class="form-label"><strong>Valori disponibili</strong></label>
            <textarea class="form-control" id="azione_photoshop_options" name="azione_photoshop_options" 
                      rows="4" placeholder="Inserisci i valori uno per riga&#10;Es:&#10;plettri bianchi&#10;plettri neri&#10;plettri rossi"><%= @flow&.azione_photoshop_options %></textarea>
            <small class="text-muted">Un valore per riga. Questi valori appariranno nel dropdown durante la pre-stampa</small>
          </div>

          <div class="mb-3">
            <label for="default_azione_photoshop" class="form-label">Valore di Default</label>
            <input type="text" class="form-control" id="default_azione_photoshop" 
                   name="default_azione_photoshop" value="<%= @flow&.default_azione_photoshop %>"
                   placeholder="Valore di default (deve essere nella lista dei valori sopra)">
            <small class="text-muted">Il valore selezionato di default nel dropdown</small>
          </div>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">💾 Salva Flusso</button>
      <a href="/print_flows" class="btn btn-secondary">Annulla</a>
    </div>

    <script>
      function updateActionDestination(card) {
        const executor = card.querySelector('.action-executor').value;
        card.querySelectorAll('.executor-fields').forEach((fields) => {
          const visible = fields.dataset.executor === executor;
          fields.hidden = !visible;
          fields.querySelectorAll('.destination-select').forEach((select) => {
            select.required = visible && executor !== 'none';
          });
        });
      }

      document.querySelectorAll('.action-destination').forEach((card) => {
        const executor = card.querySelector('.action-executor');
        executor.addEventListener('change', () => updateActionDestination(card));
        updateActionDestination(card);
      });

      document.getElementById('azione_photoshop_enabled').addEventListener('change', function() {
        const optionsDiv = document.getElementById('azione-photoshop-options');
        optionsDiv.style.display = this.checked ? 'block' : 'none';
      });
    </script>
  </form>
</div>
