<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="fas fa-users"></i> CRM Dashboard</h1>
  
  <form method="get" action="/crm" class="d-flex gap-2 align-items-center">
    <label class="small text-muted mb-0 me-2">Filtra per Negozio:</label>
    <select name="store_id" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
      <option value="">Tutti i Negozi</option>
      <% @stores.each do |store| %>
        <option value="<%= store.id %>" <%= 'selected' if params[:store_id] == store.id.to_s %>><%= store.name %></option>
      <% end %>
    </select>
  </form>
</div>

<div class="row mb-4">
  <div class="col-md-3">
    <div class="card">
      <div class="card-body text-center">
        <h3 class="mb-1"><%= @total_customers %></h3>
        <small class="text-muted"><i class="fas fa-user"></i> Clienti Totali</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body text-center">
        <h3 class="mb-1">&euro; <%= '%.2f' % @total_revenue %></h3>
        <small class="text-muted"><i class="fas fa-coins"></i> Fatturato Totale</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body text-center">
        <h3 class="mb-1"><%= @total_sales %></h3>
        <small class="text-muted"><i class="fas fa-shopping-cart"></i> Vendite Totali</small>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card">
      <div class="card-body text-center">
        <h3 class="mb-1">&euro; <%= '%.2f' % @avg_order_value %></h3>
        <small class="text-muted"><i class="fas fa-receipt"></i> Valore Medio Ordine</small>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-md-6">
    <div class="card">
      <div class="card-body text-center">
        <h5 class="mb-2">Ultimi 30 Giorni</h5>
        <div class="d-flex justify-content-around">
          <div>
            <h4 class="text-success mb-0">&euro; <%= '%.2f' % @revenue_30d %></h4>
            <small class="text-muted">Fatturato</small>
          </div>
          <div>
            <h4 class="mb-0"><%= @orders_30d %></h4>
            <small class="text-muted">Ordini</small>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card">
      <div class="card-body text-center">
        <h5 class="mb-2">Ultimi 7 Giorni</h5>
        <div class="d-flex justify-content-around">
          <div>
            <h4 class="text-success mb-0">&euro; <%= '%.2f' % @revenue_7d %></h4>
            <small class="text-muted">Fatturato</small>
          </div>
          <div>
            <h4 class="mb-0"><%= @orders_7d %></h4>
            <small class="text-muted">Ordini</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row mb-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-chart-area"></i> Andamento Fatturato (30 giorni)</span>
      </div>
      <div class="card-body">
        <canvas id="revenueChart" height="80"></canvas>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-trophy"></i> Top Clienti per Spesa</span>
        <a href="/crm/customers?sort=spent_desc" class="btn btn-sm btn-outline-primary">Vedi tutti</a>
      </div>
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>Cliente</th>
              <th class="text-end">Spesa Totale</th>
              <th class="text-center">Ordini</th>
            </tr>
          </thead>
          <tbody>
            <% @top_customers.each do |customer| %>
            <tr>
              <td>
                <a href="/crm/customers/<%= customer.id %>"><%= customer.full_name %></a>
                <br><small class="text-muted"><%= customer.email %></small>
              </td>
              <td class="text-end fw-bold">&euro; <%= '%.2f' % (customer.total_spent || 0) %></td>
              <td class="text-center"><%= customer.order_count || 0 %></td>
            </tr>
            <% end %>
            <% if @top_customers.empty? %>
            <tr><td colspan="3" class="text-center text-muted py-4">Nessun cliente importato</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-clock"></i> Vendite Recenti</span>
        <a href="/crm/sales" class="btn btn-sm btn-outline-primary">Vedi tutte</a>
      </div>
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>Ordine</th>
              <th>Negozio</th>
              <th>Cliente</th>
              <th class="text-end">Totale</th>
              <th>Data</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_sales.each do |sale| %>
            <tr>
              <td><strong><%= sale.external_order_code %></strong></td>
              <td><small><%= sale.store&.name || '-' %></small></td>
              <td>
                <% if sale.customer %>
                  <a href="/crm/customers/<%= sale.customer_id %>"><%= sale.customer.full_name %></a>
                <% end %>
              </td>
              <td class="text-end">&euro; <%= '%.2f' % (sale.total || 0) %></td>
              <td><%= sale.order_date&.strftime('%d/%m/%Y') %></td>
            </tr>
            <% end %>
            <% if @recent_sales.empty? %>
            <tr><td colspan="4" class="text-center text-muted py-4">Nessuna vendita importata</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  fetch('/api/crm/revenue-chart?store_id=<%= params[:store_id] %>')
    .then(r => r.json())
    .then(data => {
      new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
          labels: data.labels.map(d => {
            const parts = d.split('-');
            return parts[2] + '/' + parts[1];
          }),
          datasets: [{
            label: 'Fatturato (€)',
            data: data.data,
            borderColor: '#e91e8c',
            backgroundColor: 'rgba(233, 30, 140, 0.1)',
            fill: true,
            tension: 0.4,
            pointRadius: 3
          }]
        },
        options: {
          responsive: true,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, ticks: { callback: v => '€' + v } }
          }
        }
      });
    });
</script>
